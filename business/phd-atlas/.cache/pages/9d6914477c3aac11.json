ud559\ubd80\ub294 2002\ub144 3\uc6d4, \uad50\uc721\uacfc \uc5f0\uad6c\uc758 \uc2dc\ub108\uc9c0\ub97c \uadf9\ub300\ud654\ud558\uae30 \uc704\ud574 \uc804\uae30\uacf5\ud559\uacfc(1950\ub144 \uc124\ub9bd), \uc804\uc790\uacf5\ud559\uacfc(1969\ub144 \uc124\ub9bd), \uc804\ud30c\uacf5\ud559\uacfc(1992\ub144 \uc124\ub9bd)\ub97c \ud1b5\ud569\ud558\uc5ec \uc0c8\ub86d\uac8c \ucd9c\ubc94\ud558\uc600\uc2b5\ub2c8\ub2e4. \uc774\ud6c4 \uc804\uae30\u00b7\uc804\uc790\u00b7\uc804\ud30c \uc0b0\uc5c5\uc758 \ubc1c\uc804\uc744 \uc774\ub04c\uc5b4 \uc628 \uc804\ud1b5\uc744 \ubc14\ud0d5\uc73c\ub85c \uc2dc\ub300\uac00 \uc694\uad6c\ud558\ub294 \ucc3d\uc758\uc801\uc774\uace0 \ucc45\uc784\uac10 \uc788\ub294 \uacf5\ud559 \uc778\uc7ac\ub97c \uc591\uc131\ud574 \uc654\uc73c\uba70, \uc624\ub298\ub0a0\uc5d0\ub294 \uc804\uae30\uc804\uc790 \ubd84\uc57c\ub97c \uc120\ub3c4\ud558\ub294 \uad50\uc721 \ubc0f \uc5f0\uad6c \uacf5\ub3d9\uccb4\ub85c \uc790\ub9ac\ub9e4\uae40\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4. \ud3ed\ub113\uc740 \ud559\ubb38\uc801 \uae30\ubc18 \uc704\uc5d0\uc11c \uc6b0\uc218\ud55c \uad50\uc721\uacfc \ud65c\ubc1c\ud55c \uc5f0\uad6c\ub97c \uc774\uc5b4\uac00\uace0 \uc788\uc73c\uba70, \ud2b9\ud788 \ub300\ud559\uc6d0 \uacfc\uc815\uc740 \uc815\ubd80 \uc8fc\uad00 BK21 \uc0ac\uc5c5\uc758 \uc6b0\uc218 \uc5f0\uad6c \uc0ac\uc5c5\ub2e8\uc5d0 \uc9c0\uc18d\uc801\uc73c\ub85c \uc120\uc815\ub418\uba70 \uc5f0\uad6c \uc5ed\ub7c9\uacfc \uad50\uc721 \uacbd\uc7c1\ub825\uc744 \ub110\ub9ac \uc778\uc815\ubc1b\uace0 \uc788\uc2b5\ub2c8\ub2e4.\n\ubcf8 \ud559\ubd80\ub294 \ube60\ub974\uac8c \ubcc0\ud654\ud558\ub294 \uc0b0\uc5c5 \ud658\uacbd\uc5d0 \ub2a5\ub3d9\uc801\uc73c\ub85c \ub300\uc751\ud558\uae30 \uc704\ud574 BASIC(Bio-Health, Artificial Intelligence, Semiconductor, Infra, and Communication) \ubd84\uc57c\ub97c \uc911\uc2ec\uc73c\ub85c \uad50\uc721\uacfc \uc5f0\uad6c\uc758 \ubc29\ud5a5\uc744 \uace0\ub3c4\ud654\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4. \uc544\uc6b8\ub7ec \ud559\ubd80\uc640 \ub300\ud559\uc6d0\uc744 \uc544\uc6b0\ub974\ub294 \uc5f0\uacc4 \uad50\uc721\uacfc\uc815, \ud559\uc81c \uac04 \uc735\ud569, \uad6d\uc81c \uacf5\ub3d9\uc5f0\uad6c\ub97c \uc801\uadf9\uc801\uc73c\ub85c \ucd94\uc9c4\ud558\uba70 \uc138\uacc4\uc801 \uc218\uc900\uc758 \uad50\uc721 \ubc0f \uc5f0\uad6c \uc5ed\ub7c9\uc744 \uac16\ucd98 \ud559\ubb38 \uacf5\ub3d9\uccb4\ub85c \ub3c4\uc57d\ud558\uace0\uc790 \ud569\ub2c8\ub2e4. \uc55e\uc73c\ub85c\ub3c4 \uc138\uacc4 \uc720\uc218\uc758 \ub300\ud559, \uc5f0\uad6c\uc18c, \uc0b0\uc5c5\uccb4\uc640\uc758 \ud611\ub825\uc744 \ub354\uc6b1 \ud655\ub300\ud558\uace0, \uc5f0\uc138\ub300\ud559\uad50\uc758 \ucc3d\ub9bd \uc774\ub150\uc778 \uae30\ub3c5\uad50 \uc815\uc2e0\uc5d0 \uc785\uac01\ud55c \uc62c\ubc14\ub978 \uc778\uc131\uacfc \uc12c\uae40\uc758 \ub9ac\ub354\uc2ed\uc744 \uac16\ucd98 \uacf5\ud559 \uc9c0\ub3c4\uc790\ub97c \uae38\ub7ec\ub0b4\ub294 \uac83\uc744 \uc911\uc694\ud55c \uc0ac\uba85\uc73c\ub85c \uc0bc\uace0 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub97c \ud1b5\ud574 \uc804\ubb38\uc131\uacfc \ud488\uaca9, \uadf8\ub9ac\uace0 \uacf5\ub3d9\uccb4\uc801 \ucc45\uc784\uac10\uc744 \ub450\ub8e8 \uac16\ucd98 \uc778\uc7ac\ub97c \ubc30\ucd9c\ud558\uba70 \ub354 \ub098\uc740 \ubbf8\ub798 \uc0ac\ud68c\uc5d0 \uae30\uc5ec\ud558\uaca0\uc2b5\ub2c8\ub2e4.\n\ubcf8 \ud559\ubd80\uc758 \uc878\uc5c5\uc0dd\ub4e4\uc740 \uc804\uae30\uc804\uc790\uacf5\ud559 \uc804 \ubd84\uc57c\uc5d0 \uac78\uccd0 \uc0b0\uc5c5\uacc4, \uc5f0\uad6c\uae30\uad00, \ub300\ud559 \ub4f1 \ub2e4\uc591\ud55c \uc601\uc5ed\uc5d0\uc11c \uc911\ucd94\uc801 \uc5ed\ud560\uc744 \ub2f4\ub2f9\ud558\uba70 \uc804\ubb38\uc131\uc744 \ubc1c\ud718\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c \ub300\ud559\uc6d0\uc5d0\uc11c \ud559\uc704\ub97c \ucde8\ub4dd\ud55c \uc778\uc7ac\ub4e4\uc740 \ub300\ud559\uad50\uc218 \ubc0f \uad6d\uac00\u00b7\uc0b0\uc5c5\uccb4 \uc5f0\uad6c\uc18c\uc758 \uc5f0\uad6c\uc6d0\uc73c\ub85c \uc9c4\ucd9c\ud558\uc5ec \ud559\ubb38\uc801 \uc131\uacfc\uc640 \uae30\uc220 \ud601\uc2e0\uc744 \uc774\ub044\ub294 \ud575\uc2ec \uc778\uc7ac\ub85c \ud65c\uc57d\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4.\n\uac1c\uc778\uc815\ubcf4\ucc98\ub9ac\ubc29\uce68\n\ubc95\uc801\uace0\uc9c0\n(03722) \uc11c\uc6b8\ud2b9\ubcc4\uc2dc \uc11c\ub300\ubb38\uad6c \uc5f0\uc138\ub85c 50 \uc5f0\uc138\ub300\ud559\uad50 \uacf5\uacfc\ub300\ud559\ncopyrights (C) 2020 YONSEI UNIVERSITY College of Engineering. All rights reserved\n\uad50\ub0b4\uc8fc\uc694\uc0ac\uc774\ud2b8\n\uad50\ubaa9\uc2e4\n\uad6d\uc81c\ucc98\n\ub9ac\ub354\uc2ed\uc13c\ud130\n\uc5f0\uad6c\ucc98/\uc0b0\ud559\ud611\ub825\ub2e8\n\uc5f0\uc138\ucd98\ucd94\n\uc6f9\uba54\uc77c\n\uc77c\ubc18\ub300\ud559\uc6d0\n\ud559\uc0ac\ud3ec\ud0c8\uc2dc\uc2a4\ud15c\n\uc815\ubcf4\ud1b5\uc2e0\uc11c\ube44\uc2a4\n\ud559\uc220\uc815\ubcf4\uc11c\ube44\uc2a4\n\uc911\uc559\ubc15\ubb3c\uad00\n\ucde8\uc5c5\uc548\ub0b4\n\ud55c\uad6d\uc5b4\ud559\ub2f9\n\ud559\uc220\uc815\ubcf4\uc11c\ube44\uc2a4(\uc6d0\uc8fc)\nTOP", "links": [["\ubcf8\ubb38 \ubc14\ub85c\uac00\uae30", "https://engineering.yonsei.ac.kr/engineering/about/major_2_1.do#jwxe_main_content"], ["\uc8fc\uba54\ub274 \ubc14\ub85c\uac00\uae30", "https://engineering.yonsei.ac.kr/engineering/about/major_2_1.do#jwxe_main_menu"], ["\uc11c\ube0c\uba54\ub274 \ubc14\ub85c\uac00\uae30", "https://engineering.yonsei.ac.kr/engineering/about/major_2_1.do#jwxe_sub_menu"], ["LANGUAGE", "https://engineering.yonsei.ac.kr/engineering/about/major_2_1.do"], ["ENGLISH", "https://devcms.yonsei.ac.kr/engineering_en/index.do"], ["\ucc98\uc74c\uc73c\ub85c", "https://engineering.yonsei.ac.kr/engineering/"], ["\ub300\ud45c \ud648\ud398\uc774\uc9c0", "https://www.yonsei.ac.kr/sc/index.do"], ["", "https://engineering.yonsei.ac.kr/engineering/"], ["\ubaa8\ubc14\uc77c \uba54\ub274 \uc5f4\uae30", "https://engineering.yonsei.ac.kr/engineering/about/major_2_1.do#a"], ["\ub300\ud559\uc18c\uac1c", "https://engineering.yonsei.ac.kr/engineering/intro/greetings.do"], ["\ud559\uc7a5 \uc778\uc0ac\ub9d0", "https://engineering.yonsei.ac.kr/engineering/intro/greetings.do"], ["\ube44\uc804 \ubc0f \ub