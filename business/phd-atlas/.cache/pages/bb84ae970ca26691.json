c5f0\uad6c\uc18c\nAcademics\n\ubaa8\uc9d1\uc548\ub0b4\n\uc785\ud559\uacf5\uc9c0\n\uc878\uc5c5\uad00\ub828\uaddc\uc815\n\uc774\uc218\uaddc\uc815\n\uad50\uacfc\uacfc\uc815\n\uad50\uacfc\uc778\uc99d\uacfc\uc815\n\uc790\ub8cc\uc2e4\n\uc735\ud569\uc804\uacf5 \uc751\uc6a9 \ub370\uc774\ud130\uc0ac\uc774\uc5b8\uc2a4\n\ucc38\uc5ec\ud559\uacfc(\ubd80)\n\uc9c4\uc785\uc548\ub0b4 \ubc0f \uc18c\uac1c \ub3d9\uc601\uc0c1\n\uad50\uacfc\uacfc\uc815\n\uc774\uc218\uaddc\uc815\nNews\n\ud559\uacfc\uc18c\uc2dd\n\uc138\ubbf8\ub098\nMEDIA\n\uacf5\uc9c0\uc0ac\ud56d\nBootcamp\nAI CHALLENGE\nBK21\n\ub2e8\uc7a5\uc778\uc0ac\ub9d0\n\ube44\uc804 \ubc0f \ubaa9\ud45c\n\ucc38\uc5ec\uc778\ub825\n\uc0ac\uc5c5\uacf5\uc9c0\n\uc0ac\uc5c5\uc131\uacfc\n\uc790\ub8cc\uc2e4\n\uc735\ud569\uc804\uacf5 \uc751\uc6a9 \ub370\uc774\ud130\uc0ac\uc774\uc5b8\uc2a4\n\uc778\uc0ac\ub9d0\n\ucc38\uc5ec\ud559\uacfc(\ubd80)\n\ucc38\uc5ec\uad50\uc218\n\uc9c4\uc785\uc548\ub0b4 \ubc0f \uc18c\uac1c \ub3d9\uc601\uc0c1\n\uad50\uacfc\uacfc\uc815\n\uc774\uc218\uaddc\uc815\n\uc735\ud569\uc804\uacf5 \uacf5\uc9c0\uc0ac\ud56d\n\uc9c4\uc785\uc548\ub0b4\n\uc120\ubc1c\uaddc\ubaa8\n\uc5f0\uac04 \uc815\uc6d0: \uc11d\uc0ac\uacfc\uc815 40\uba85, \ubc15\uc0ac\uacfc\uc815 20\uba85, \uc11d\ubc15\uc0ac \ud1b5\ud569\uacfc\uc815 20\uba85\n\ud559\uae30\ubcc4 \uc815\uc6d0: \ubcc0\ub3d9 \uac00\ub2a5(\uff0a \uc9c0\uc6d0\ud558\uace0\uc790 \ud558\ub294 \ud559\uae30\uc758 \uc120\ubc1c \uacf5\uace0 \ucc38\uc870)\n\uc9c0\uc6d0\uc790\uaca9\n\uc8fc\uad00\ud559\uacfc(\ub370\uc774\ud130\uc0ac\uc774\uc5b8\uc2a4\ub300\ud559\uc6d0 \ub370\uc774\ud130\uc0ac\uc774\uc5b8\uc2a4\ud559\uacfc) \ubc0f \ucc38\uc5ec\ud559\uacfc(\ubd80) \uc18c\uc18d\uc758 \ud559\uc0dd(\uc785\ud559\uc608\uc815\uc790 \ud3ec\ud568)\uc73c\ub85c \ud559\uc0dd\uc774 \ud604\uc7ac \uc774\uc218 \uc911\uc778 \ud559\uc704\uacfc\uc815\uacfc \ub3d9\uc77c\ud55c \ud559\uc704\uacfc\uc815\uc5d0 \ud55c\ud558\uc5ec \uc9c0\uc6d0\ud560 \uc218 \uc788\ub2e4.\n\uc120\ubc1c\ubc29\ubc95\n\uacf5\uc9c0\uc0ac\ud56d \uac8c\uc2dc\ud310 \ucc38\uc870\n\uc2e0\uaddc \uc9c4\uc785\uc0dd \uc120\ubc1c\n\uc120\ubc1c \uc5f0\ud601: 2024\ud559\ub144\ub3c4 2\ud559\uae30\ubd80\ud130 \uc120\ubc1c\n1\ud559\uae30 \uc2e0\uaddc \uc9c4\uc785: \uc9c1\uc804 \ud559\uae30 2\uc6d4 \ucd08(3\uc6d4 \uacb0\uacfc \ubc1c\ud45c)\n2\ud559\uae30 \uc2e0\uaddc \uc9c4\uc785: \uc9c1\uc804 \ud559\uae30 8\uc6d4 \ucd08(9\uc6d4 \uacb0\uacfc \ubc1c\ud45c)\n\ubb38\uc758\n(\uc9c4\uc785, \uc774\uc218) \ub370\uc774\ud130\uc0ac\uc774\uc5b8\uc2a4\ub300\ud559\uc6d0 \ud589\uc815\uc2e4 / 02-880-9765, tjsdud3927@snu.ac.kr\n(\uc218\uc5c5) \ub370\uc774\ud130\uc0ac\uc774\uc5b8\uc2a4\ub300\ud559\uc6d0 \ud589\uc815\uc2e4 / 02-880-9768, shinehsy@snu.ac.kr\n\uc735\ud569\uc804\uacf5 \uc751\uc6a9 \ub370\uc774\ud130\uc0ac\uc774\uc5b8\uc2a4 \uc8fc\uc784\uad50\uc218 / 02-880-9783, swlee69@snu.ac.kr\nSeoul National University\nGraduate School of Data Science\nAbout\n\uc778\uc0ac\ub9d0\n\ub300\ud559\uc6d0 \uc18c\uac1c\n\uc5f0\ud601\n\uc624\uc2dc\ub294 \uae38\n\uae30\ubd80\ud558\uae30\nPeople\n\uc804\uc784 \uad50\uc218\uc9c4\n\ube44\uc804\uc784 \uad50\uc218\uc9c4\n\uc735\ud569\uc804\uacf5 \uad50\uc218\uc9c4\n\ub300\ud559\uc6d0\uc0dd\n\ud589\uc815\uc9c1\uc6d0\nRESEARCH\nResearch Highlights\n\uc120\ub3c4\uc5f0\uad6c\uc13c\ud130(ERC)\n\ub370\uc774\ud130\uc0ac\uc774\uc5b8\uc2a4\uc5f0\uad6c\uc18c\nAcademic\n\ubaa8\uc9d1\uc548\ub0b4\n\uc785\ud559\uacf5\uc9c0\n\uc878\uc5c5\uad00\ub828\uaddc\uc815\n\uc774\uc218\uaddc\uc815\n\uad50\uacfc\uacfc\uc815\n\uad50\uacfc\uc778\uc99d\uacfc\uc815\n\uc790\ub8cc\uc2e4\n\uc735\ud569\uc804\uacf5 \uc751\uc6a9 \ub370\uc774\ud130\uc0ac\uc774\uc5b8\uc2a4\nNews\n\ud559\uacfc\uc18c\uc2dd\n\uc138\ubbf8\ub098\nMEDIA\n\uacf5\uc9c0\uc0ac\ud56d\nBK21\n\ub2e8\uc7a5\uc778\uc0ac\ub9d0\n\ube44\uc804 \ubc0f \ubaa9\ud45c\n\ucc38\uc5ec\uc778\ub825\n\uc0ac\uc5c5\uacf5\uc9c0\n\uc0ac\uc5c5\uc131\uacfc\n\uc790\ub8cc\uc2e4\nSeoul National University \u00a9 2023. All rights reserved.\n\uac1c\uc778\uc815\ubcf4\ucc98\ub9ac\ubc29\uce68\n\uc601\uc0c1\uc8