81fa\u7063\u96fb\u529b\u516c\u53f8\u3001\u81fa\u7cd6\u3001\u4e2d\u570b\u92fc\u9435\u516c\u53f8\u3001\u69ae\u6c11\u5de5\u7a0b\u8655\u53ca\u5927\u578b\u4e4b\u5de5\u7a0b\u9867\u554f\u516c\u53f8\u7b49\u3002\n\u7cfb\u6240\u4ecb\u7d39\n\u4e2d\u6587\u7248\u7db2\u9801\u7db2\u5740\nhttp://web.gl.ntu.edu.tw/\n\u7cfb\u6240\u7c21\u4ecb\n\u570b\u7acb\u81fa\u7063\u5927\u5b78\u7684\u524d\u8eab\u662f\u65e5\u672c\u81fa\u5317\u5e1d\u570b\u5927\u5b78\uff0c\u6210\u7acb\u65bc\u6c11\u570b17\u5e74\uff081928\u5e74\uff09\uff0c\u662f\u81fa\u7063\u6700\u65e9\u8a2d\u7acb\u7684\u5927\u5b78\u3002\u6c11\u570b29\u5e74\uff081940\u5e74\uff09\u7406\u8fb2\u5b78\u90e8\u64f4\u5927\u7de8\u5236\uff0c\u5176\u4e2d\u7406\u5b78\u90e8\u9580\u6539\u7de8\u70ba\u5316\u5b78\u3001\u5730\u8cea\u5b78\u3001\u52d5\u7269\u5b78\u3001\u690d\u7269\u5b78\u56db\u500b\u300e\u5c08\u653b\u300f\u5b78\u9580\uff0c\u7562\u696d\u751f\u6388\u4e88\u7406\u5b78\u58eb\uff0c\u5960\u5b9a\u4e86\u5730\u8cea\u7cfb\u7684\u57fa\u790e\u3002\u6c11\u570b32\u5e74\uff081943\u5e74\uff09\u7406\u8fb2\u5b78\u90e8\u5206\u7acb\u70ba\u7406\u5b78\u90e8\u8207\u8fb2\u5b78\u90e8\uff0c\u5730\u8cea\u5b78\u79d1\u70ba\u7406\u5b78\u90e8\u4e0b\u8a2d\u56db\u79d1\u4e4b\u4e00\u3002\u6c11\u570b34\u5e74\uff081945\u5e74\uff09\u81fa\u7063\u5149\u5fa9\u5f8c\uff0c\u65e5\u672c\u5e1d\u570b\u5927\u5b78\u6613\u540d\u70ba\u570b\u7acb\u81fa\u7063\u5927\u5b78\uff0c\u7406\u5b78\u90e8\u5730\u8cea\u5b78\u79d1\u6539\u70ba\u7406\u5b78\u9662\u5730\u8cea\u5b78\u7cfb\u3002\u6c11\u570b44\u5e74\uff081956\u5e74\uff09\u6210\u7acb\u5730\u8cea\u5b78\u7814\u7a76\u6240\uff0c\u958b\u59cb\u62db\u6536\u78a9\u58eb\u73ed\u7814\u7a76\u751f\u3002\u6c11\u570b59\u5e74\uff081970\u5e74\uff09\u518d\u589e\u8a2d\u535a\u58eb\u73ed\uff0c\u6210\u70ba\u6211\u570b\u7814\u7a76\u5730\u8cea\u5b78\u8207\u57f9\u990a\u5730\u8cea\u5b78\u79d1\u4eba\u624d\u4e4b\u4e3b\u8981\u5b78\u8853\u6a5f\u69cb\u3002\u70ba\u56e0\u61c9\u793e\u6703\u767c\u5c55\u4e4b\u9700\u8981\uff0c\u672c\u6240\u65bc\u6c11\u570b82\u5e74\uff081993\u5e74\uff09\u5c07\u78a9\u58eb\u73ed\u5206\u70ba\u5730\u8cea\u7d44\u8207\u61c9\u7528\u5730\u8cea\u7d44\uff0c\u4e26\u65bc\u6c11\u570b89\u5e74(2000\u5e74)\u66f4\u540d\u70ba\u5730\u8cea\u79d1\u5b78\u7cfb\u3002\n\u672c\u7cfb\u4e4b\u5b78\u8853\u7814\u7a76\u91cd\u9ede\u9818\u57df\uff0c\u4e0d\u4f46\u5305\u542b\u50b3\u7d71\u5730\u8cea\u5b78\uff08\u5982\u7926\u7269\u5ca9\u77f3\u3001\u5730\u9ad4\u69cb\u9020\u3001\u69cb\u9020\u5730\u8cea\u3001\u5730\u8cea\u8cc7\u6e90\uff09\u3001\u5730\u7403\u7269\u7406\u3001\u5730\u7403\u5316\u5b78\u3001\u5730\u8cea\u707d\u5bb3\uff08\u5c71\u5d29\u3001\u571f\u77f3\u6d41\u3001\u706b\u5c71\u3001\u5730\u9707\u7b49\uff09\u3001\u74b0\u5883\u5730\u8cea\u5b78\uff0c\u9084\u6709\u65e5\u76ca\u91cd\u8981\u7684\u5168\u7403\u8b8a\u9077\u7814\u7a76\u7b49\u3002\n\u672c\u7cfb\u8a2d\u7f6e\u4e8c\u5341\u9918\u9593\u5be6\u9a57\u5ba4\u8207\u8af8\u591a\u5148\u9032\u7684\u7814\u7a76\u8a2d\u5099\uff0c\u5176\u4e2d\u66f4\u5305\u542b\u5168\u81fa\u7063\u76ee\u524d\u552f\u4e00\u4e00\u53f0\u7528\u4f86\u9032\u884c\u78b3\u5341\u56db\u5b9a\u5e74\u548c\u5176\u4ed6\u5b87\u5b99\u6e90\u540c\u4f4d\u7d20\u7684\u6e2c\u91cf\u7684AMS\u52a0\u901f\u5668\u8cea\u8b5c\u5100\uff0c\u4ee5\u53ca\u96fb\u5b50\u5fae\u63a2\u5100\u3001\u6c2c\u2500\u6c2c\u5b9a\u5e74\u8a2d\u5099\u3001X\u5149\u87a2\u5149\u5206\u6790\u5100\u3001\u5316\u5b78\u5206\u6790\u5be6\u9a57\u5ba4\u3001X\u5149\u7e5e\u5c04\u5100\u3001\u611f\u61c9\u85d5\u5408\u96fb\u6f3f\u539f\u5b50\u653e\u5c04\u5149\u8b5c\u5206\u6790\u5100\u3001\u611f\u61c9\u85d5\u8026\u5408\u96fb\u6f3f\u8cea\u8b5c\u5100\u3001\u7a69\u5b9a\u540c\u4f4d\u7d20\u8cea\u8b5c\u5100\u8207\u7a00\u6709\u6c23\u9ad4\u5206\u6790\u8cea\u8b5c\u5100\u3001\u6c89\u7a4d\u5be6\u9a57\u5ba4\u3001\u71b1\u87a2\u5149\u5be6\u9a57\u5ba4\u3001\u5730\u8cea\u6750\u6599\u529b\u5b78\u5be6\u9a57\u5ba4\u3001\u5730\u5f62\u6e2c\u91cf\u5100\u7b49\u3002\n\u806f\u7d61\u8cc7\u8a0a\n\u884c\u653f\u4eba\u54e1\n\u59d3\u540d\uff1a\n\u5ed6\u5b50\u6587 \u5148\u751f\n\u96fb\u8a71\uff1a886-2-33669475\nEmail\uff1atzuwenliao@ntu.edu.tw\n\u6388\u8ab2\u8a9e\u8a00\n\u82f1\u6587\u6388\u8ab2\n\u6700\u4f4e\u8a9e\u8a00\u8981\u6c42\u9580\u6abb\n* \u82f1\u6587\u80fd\u529b\uff1a\n\u76f8\u7576\u65bc CEFR \u6307\u5b9a\u7d1a\u6578\u4ee5\u4e0a\u4e4b\u82f1\u6587\u80fd\u529b\u8b49\u660e (\u9ad8\u968e\u7d1a B2 (\u542b)\u4ee5\u4e0a) [\u82f1\u6587\u4e3b\u8981\u6aa2\u6e2c\u5c0d\u7167\u53c3\u8003\u8868]\n\u96c5\u601d IELTS IELTS 5.5 (\u542b)\u4ee5\u4e0a\n\u6258\u798f TOEFL (iBT) TOEFL (iBT) 72 (\u542b)\u4ee5\u4e0a\n\u6258\u798f TOEFL (iBT) (\u65b0\u5236) TOEFL iBT (New Scoring Scale) 4 (\u542b)\u4ee5\u4e0a\n\u6258\u798f TOEFL (ITP) TOEFL ITP 543 (\u542b)\u4ee5\u4e0a\n\u591a\u76ca TOEIC TOEIC 785 (\u542b)\u4ee5\u4e0a\n\u528d\u6a4b\u82f1\u8a9e\u80fd\u529b\u6e2c\u9a57 Cambridge English First (FCE) (\u542b)\u4ee5\u4e0a\n\u5168\u6c11\u82f1\u6aa2 GEPT General English Proficiency Test (GEPT) \u4e2d\u9ad8\u7d1a (\u542b)\u4ee5\u4e0a\n\u666e\u601d\u901a\u7528\u7248 Aptis General Overall CEFR B2 (\u542b)\u4ee5\u4e0a\n\u57f9\u529b\u82f1\u8a9e\u80fd\u529b\u6aa2\u5b9a\u6e2c\u9a57 BEST Test of English Proficiency 200 (\u542b)\u4ee5\u4e0a\n* \u82f1\u6587\u80fd\u529b\u8b49\u660e\u514d\u7e73\u689d\u4ef6\uff1a\n-- \u570b\u7c4d\u70ba\u82f1\u8a9e\u7cfb\u570b\u5bb6\u4e4b\u7533\u8acb\u8005\u514d\u7e73\n-- \u5728\u82f1\u8a9e\u7cfb\u570b\u5bb6\u53d6\u5f97\u524d\u4e00\u5b78\u4f4d\u4e4b\u7533\u8acb\u8005\u514d\u7e73\n-- \u524d\u4e00\u5b78\u4f4d\u70ba\u5168\u82f1\u8a9e\u6388\u8ab2\u4e4b\u7533\u8acb\u8005\u514d\u7e73\n\u7cfb\u6240\u5efa\u8b70\u8a9e\u8a00\u80fd\u529b\n\u6bd4\u7167\u5168\u6821\u6700\u4f4e\u8a9e\u8a00\u8981\u6c42\u9580\u6abb\n\u7533\u8acb\u6240\u9700\u6587\u4ef6\n\u8b77\u7167\u6216\u8eab\u5206\u8b49\u4ef6\n[\u8aaa\u660e]\n\u8acb\u4e0a\u50b3\u8b77\u7167\u6383\u63cf\u6a94\uff1b\u82e5\u7121\u8b77\u7167\u8005\uff0c\u8acb\u63d0\u4f9b\u76f8\u95dc\u8eab\u5206\u8b49\u660e\u6587\u4ef6\uff0c\u5982\u60a8\u7684\u8eab\u5206\u8b49\u3001\u99d5\u7167\u7b49\u6e05\u695a\u6a19\u793a\u60a8\u7684\u59d3\u540d\u8207\u570b\u7c4d\u7684\u5b98\u65b9\u6587\u4ef6\u3002\n\u5916\u50d1\u5c45\u7559\u8b49 (\u82e5\u6709)\n[\u8aaa\u660e]\n\u82e5\u60a8\u66fe\u65bc\u81fa\u7063\u7533\u8fa6\u904e\u5c45\u7559\u8b49\uff0c\u8acb\u4e0a\u50b3\u96fb\u5b50\u6a94\u65bc\u6b64\u3002\n\u6700\u9ad8\u5b78\u6b77\u7562\u696d\u8b49\u66f8 - \u6b63\u672c\n[\u8aaa\u660e]\n\u8acb\u4e0a\u50b3\u5c31\u8b80\u5b78\u6821\u51fa\u5177\u4e4b\u6b63\u5f0f\u7562\u696d\u8b49\u66f8\u3002\u61c9\u5c46\u7562\u696d\u751f\u8acb\u7e73\u4ea4\u5c31\u8b80\u5b78\u6821\u51fa\u5177\u4e4b\u9810\u8a08\u7562\u696d\u8b49\u660e\u66f8\u6216\u5728\u5b78\u8b49\u660e\u66f8\u3002\n\u6700\u9ad8\u5b78\u6b77\u6b77\u5e74\u6210\u7e3e\u55ae (\u9700\u5305\u542b\u6b77\u5e74\u6210\u7e3e\u8207\u5206\u6578\u7b49\u7d1a\u8aaa\u660e) - \u6b63\u672c\n[\u8aaa\u660e]\n\u9ad8\u4e2d\u7562\u696d\u751f\u9808\u7e73\u4ea410\u81f312\u5e74\u7d1a\u4e4b\u6b77\u5e74\u6210\u7e3e\u55ae\u3002\u82e5\u5176\u7562\u696d\u5e74\u7d1a\u76f8\u7576\u65bc\u6211\u570b\u9ad8\u7d1a\u4e2d\u7b49\u5b78\u6821\u4e8c\u5e74\u7d1a\u4e4b\u5916\u570b\u540c\u7d1a\u540c\u985e\u5b78\u6821\u7562\u696d\u751f\uff0c\u5247\u9808\u7e73\u4ea47\u81f311\u5e74\u7d1a\u4e4b\u6210\u7e3e\u55ae\u3002\n\u6700\u9ad8\u5b78\u6b77\u7562\u696d\u8b49\u66f8 - \u8b6f\u672c\n[\u8aaa\u660e]\n\u82e5\u6b63\u672c\u975e\u82f1\u6587\u6216\u4e2d\u6587\uff0c\u9700\u6aa2\u9644\u7ffb\u8b6f\u672c\u3002\n\u6700\u9ad8\u5b78\u6b77\u6b77\u5e74\u6210\u7e3e\u55ae (\u9700\u5305\u542b\u6b77\u5e74\u6210\u7e3e\u8207\u5206\u6578\u7b49\u7d1a\u8aaa\u660e) - \u8b6f\u672c\n[\u8aaa\u660e]\n\u82e5\u6b63\u672c\u975e\u82f1\u6587\u6216\u4e2d\u6587\uff0c\u5247\u9700\u6aa2\u9644\u7ffb\u8b6f\u672c\u3002\n\u8ca1\u529b\u8b49\u660e\u66f8\n[\u8aaa\u660e]\n\u7533\u8acb\u751f\u9808\u6aa2\u9644\u65bc\u4e09\u500b\u6708\u5167\u7531\u9280\u884c\u958b\u7acb\u4e4b\u5b58\u6b3e\u8b49\u660e\uff0c\u5176\u9808\u6709\u76f8\u7576\u65bc\u65b0\u81fa\u5e6320\u842c\u5143\u4ee5\u4e0a\u4e4b\u5b58\u6b3e\u3002\n\u5df2\u78ba\u8a8d\u7372\u5f97\u734e\u5b78\u91d1\u8005\u8acb\u63d0\u4f9b\u734e\u5b78\u91d1\u7372\u734e\u8b49\u660e\uff1b\u5df2\u7372\u672c\u6821\u6559\u6388\u6216\u7cfb\u6240\u63d0\u4f9b\u4e4b\u734e\u5b78\u91d1\u6216\u52a9\u7406\u5de5\u4f5c\u8005 , \u53ef\u63d0\u5177\u76f8\u95dc\u8b49\u660e\u66ff\u4ee3\u3002\n*\u82e5\u5b58\u6b3e\u8b49\u660e\u975e\u7533\u8acb\u751f\u672c\u4eba\u5e33\u6236\uff0c\u9664\u5b58\u6b3e\u8b49\u660e\u5916\uff0c\u9808\u53e6\u9644\u8cc7\u52a9\u8005\u7c3d\u540d\u4e4b\u8ca1\u529b\u64d4\u4fdd\u66f8\u5408\u4f75\u4e0a\u50b3\u3002\n*\u82e5\u7533\u8acb\u751f\u5b58\u6b3e\u8b49\u660e\u4e0d\u8db3\u984d\uff0c\u9808\u53e6\u9644\u8cc7\u52a9\u8005\u4e4b\u5b58\u6b3e\u8b49\u660e\uff0c\u53ca\u8cc7\u52a9\u8005\u7c3d\u540d\u4e4b\u8ca1\u529b\u64d4\u4fdd\u66f8\u5408\u4f75\u4e0a\u50b3\u3002\n\u7cfb\u6240\u8981\u6c42\u6587\u4ef6\n\u7814\u7a76\u8a08\u756b\n\u63a8\u85a6\u4fe1 2 \u4efd\n\u53e3 / \u9762\u8a66\n\u7121\n\u7b46\u8a66\n\u7121\n\u5176\u4ed6\u8aaa\u660e\n\u7121\n\u9662\u7cfb\u6240\u63d0\u4f9b\u734e\u5b78\u91d1\n\u7121\n\u81fa\u7063\u5927\u5b78\u734e\u5b78\u91d1\n\u8a73\u7d30\u8cc7\u8a0a\u8acb\u53c3\u8003\uff1a\u570b\u7acb\u81fa\u7063\u5927\u5b78\u5883\u5916\u751f\u62db\u751f\u8cc7\u8a0a>>\u7533\u8acb\u81fa\u5927>>\u734e\u5b78\u91d1\n*\u570b\u969b\u5b78\u4f4d\u751f\u82e5\u900f\u904eTIGP\u7cfb\u7d71\u7533\u8acb\uff0c\u50c5\u9069\u7528TIGP\u734e\u5b78\u91d1\uff0c\u4e0d\u5f97\u517c\u9818\u81fa\u7063\u5927\u5b78\u734e\u5b78\u91d1\u3002\n\u56de\u4e00\u89bd\u8868\n\u00d7\n\uff0e Australia \u6fb3\u5927\u5229\u4e9e\n\uff0e Bahamas \u5df4\u54c8\u99ac\n\uff0e Barbados \u5df4\u8c9d\u591a\n\uff0e Belize \u8c9d\u91cc\u65af\n\uff0e Botswana \u6ce2\u7d2e\u90a3\n\uff0e Canada \u52a0\u62ff\u5927\n\uff0e Dominica \u591a\u7c73\u5c3c\u514b\n\uff0e Federated States of Micronesia \u5bc6\u514b\u7f85\u5c3c\u897f\u4e9e\u806f\u90a6\n\uff0e Fiji \u6590\u6fdf\n\uff0e Gambia \u7518\u6bd4\u4e9e\n\uff0e Ghana \u8fe6\u7d0d\n\uff0e Grenada \u683c\u745e\u7d0d\u9054\n\uff0e Guyana \u84cb\u4e9e\u90a3\n\uff0e Ireland \u611b\u723e\u862d\n\uff0e Jamaica \u7259\u8cb7\u52a0\n\uff0e Kenya \u80af\u4e9e\n\uff0