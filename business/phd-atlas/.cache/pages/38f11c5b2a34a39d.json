ud559\uacfc(Department of Civil and Environmental Engineering)\ub294 \uc778\ub958 \ubb38\uba85\uc758 \ud1a0\ub300\uac00 \ub418\ub294 \uc0ac\ud68c\uae30\ubc18\uc2dc\uc124\uc744 \uacc4\ud68d, \uc124\uacc4, \uac74\uc124 \ubc0f \uc6b4\uc601\ud558\ub294 \uc885\ud569 \uacf5\ud559 \ud559\ubb38\uc785\ub2c8\ub2e4. \uc778\uac04\uacfc \uc790\uc5f0\uc774 \uc870\ud654\ub97c \uc774\ub8e8\ub294 \uc9c0\uc18d\uac00\ub2a5\ud55c \uc138\uc0c1\uc744 \ub9cc\ub4e4\uae30 \uc704\ud574 \ubb3c\ub9ac\uc801 \uc778\ud504\ub77c\uc758 \uc548\uc804\uc131\uc744 \ud655\ubcf4\ud558\uace0, \uc218\uc790\uc6d0\uacfc \ud658\uacbd\uc744 \ubcf4\ud638\ud558\uba70, \uc2a4\ub9c8\ud2b8 \uae30\uc220\uc744 \uc811\ubaa9\ud55c \ubbf8\ub798 \ub3c4\uc2dc \uc2dc\uc2a4\ud15c\uc744 \uad6c\ucd95\ud558\ub294 \uac83\uc744 \ubaa9\ud45c\ub85c \ud569\ub2c8\ub2e4.\n\ubcf8 \ud559\uacfc\ub294 \ud604\ub300 \uc0ac\ud68c\uc758 \ubcf5\ud569\uc801\uc778 \ubb38\uc81c\ub97c \ud574\uacb0\ud558\uae30 \uc704\ud574 \uc138 \uac00\uc9c0 \ud575\uc2ec \uc2dc\uc2a4\ud15c \ubd84\uc57c\ub85c \ub098\ub258\uc5b4 \uc804\ubb38\uc801\uc778 \uad50\uc721\uacfc \uc5f0\uad6c\ub97c \uc218\ud589\ud569\ub2c8\ub2e4. \uccab\uc9f8, \uae30\ubc18\uc2dc\uc124\uc2dc\uc2a4\ud15c(Infrastructure Systems) \ubd84\uc57c\uc5d0\uc11c\ub294 \uc0ac\ud68c \uc6b4\uc601\uc758 \uadfc\uac04\uc774 \ub418\ub294 \ubb3c\ub9ac\uc801 \uc2dc\uc124\ubb3c\uc758 \uc548\uc804\uacfc \uc131\ub2a5\uc744 \ub2e4\ub8f9\ub2c8\ub2e4. \uad6c\uc870 \ubc0f \uc7ac\ub8cc \ubd84\uc57c\uc5d0\uc11c\ub294 \uace0\uce35 \ube4c\ub529, \uad50\ub7c9, \ud130\ub110 \ub4f1 \ub300\ud615 \uad6c\uc870\ubb3c\uc758 \uc5ed\ud559\uc801 \uac70\ub3d9\uc744 \ubd84\uc11d\ud558\uace0 \ud0c4\uc18c \uc911\ub9bd\uacfc \uc7a5\uc218\uba85\uc744 \uc2e4\ud604\ud558\ub294 \ucca8\ub2e8 \uac74\uc124 \uc7ac\ub8cc\ub97c \uc5f0\uad6c\ud558\uba70, \uc9c0\ubc18\uacf5\ud559 \ubc0f \uc9c0\ubc18\ud658\uacbd\uacf5\ud559 \ubd84\uc57c\uc5d0\uc11c\ub294 \uad6c\uc870\ubb3c\uc744 \uc9c0\uc9c0\ud558\ub294 \ud1a0\uc591\uacfc \uc554\ubc18\uc758 \ud2b9\uc131\uc744 \uc774\ud574\ud558\uace0 \uc9c0\ud558 \uacf5\uac04 \uac1c\ubc1c \ubc0f \uc624\uc5fc\ub41c \uc9c0\ubc18\uc758 \uc815\ud654\uc640 \ubcf5\uc6d0\uc744 \ub2e4\ub8f9\ub2c8\ub2e4.\n\ub458\uc9f8, \uc218\uc790\uc6d0\ud658\uacbd \uc2dc\uc2a4\ud15c(Water & Environmental Systems) \ubd84\uc57c\uc5d0\uc11c\ub294 \uc0dd\uc874\uc5d0 \ud544\uc218\uc801\uc778 \ubb3c \uc790\uc6d0\uacfc \uae68\ub057\ud55c \uc0dd\ud65c \ud658\uacbd\uc744 \ubcf4\uc874\ud558\ub294 \uae30\uc220\uc744 \uc5f0\uad6c\ud569\ub2c8\ub2e4. \uc218\uc790\uc6d0 \ubc0f \uc0dd\ud0dc \ubd84\uc57c\uc5d0\uc11c\ub294 \ud64d\uc218\uc640 \uac00\ubb44 \ub4f1 \uae30\ud6c4 \ubcc0\ud654\uc5d0 \ub300\uc751\ud558\ub294 \ubb3c \uad00\ub9ac \uc2dc\uc2a4\ud15c\uc744 \uad6c\ucd95\ud558\uace0 \ud558\ucc9c \ubc0f \uc5f0\uc548\uc758 \uc0dd\ud0dc\uacc4\ub97c \ubcf4\uc874\ud558\ub294 \uae30\uc220\uc744 \uc5f0\uad6c\ud558\uba70, \ud658\uacbd\uacf5\ud559 \ubd84\uc57c\uc5d0\uc11c\ub294 \uc0c1\ud558\uc218\ub3c4 \uc2dc\uc2a4\ud15c, \ud3d0\uae30\ubb3c \ucc98\ub9ac, \ub300\uae30 \ubc0f \uc218\uc9c8 \uc815\ud654 \ub4f1 \uc624\uc5fc \ubc29\uc9c0\uc640 \uc790\uc6d0 \uc21c\ud658\uc744 \ud1b5\ud574 \ucf8c\uc801\ud55c \uc0b6\uc758 \ud130\uc804\uc744 \ub9cc\ub4e4\uc5b4 \ub098\uac11\ub2c8\ub2e4.\n\uc14b\uc9f8, \uc815\ubcf4\uacbd\uc601 \uc2dc\uc2a4\ud15c(Information & Management Systems) \ubd84\uc57c\uc5d0\uc11c\ub294 \ucca8\ub2e8 \uc815\ubcf4 \uae30\uc220\uacfc \uacbd\uc601 \uae30\ubc95\uc744 \uacb0\ud569\ud558\uc5ec \uc778\ud504\ub77c\uc758 \ud6a8\uc728\uc131\uc744 \uadf9\ub300\ud654\ud569\ub2c8\ub2e4. \uce21\ub7c9 \ubc0f \uc9c0\ud615\uacf5\uac04\uc815\ubcf4 \ubd84\uc57c\uc5d0\uc11c\ub294 \uc704\uc131, \ub4dc\ub860, \uc13c\uc11c \ub4f1\uc744 \ud65c\uc6a9\ud558\uc5ec \uc815\ubc00\ud55c \uc704\uce58 \uc815\ubcf4\ub97c \ud68d\ub4dd\ud558\uace0 \ub514\uc9c0\ud138 \ud2b8\uc708 \uad6c\ud604\uc744 \uc704\ud55c \uacf5\uac04 \uc815\ubcf4 \uc2dc\uc2a4\ud15c(GIS)\uc744 \uc5f0\uad6c\ud558\uba70, \uac74\uc124\uacbd\uc601 \ubd84\uc57c\uc5d0\uc11c\ub294 \uac74\uc124 \ud504\ub85c\uc81d\ud2b8\uc758 \uae30\ud68d\ubd80\ud130 \uc720\uc9c0\uad00\ub9ac\uae4c\uc9c0 \uc804 \uacfc\uc815\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \uad00\ub9ac\ud558\uae30 \uc704\ud55c \uacf5\uc815, \uc6d0\uac00, \uc548\uc804 \ubc0f \ubc95\uaddc\ub97c \ub2e4\ub8f9\ub2c8\ub2e4. \ub610\ud55c \uc2a4\ub9c8\ud2b8\uc2dc\ud2f0 \uc778\ud504\ub77c \ubd84\uc57c\uc5d0\uc11c\ub294 \uc778\uacf5\uc9c0\ub2a5(AI), \ube45\ub370\uc774\ud130, \uc0ac\ubb3c\uc778\ud130\ub137(IoT) \uae30\uc220\uc744 \uc804\ud1b5\uc801 \uc778\ud504\ub77c\uc5d0 \uc811\ubaa9\ud558\uc5ec \ub3c4\uc2dc \uc804\uccb4\ub97c \uc9c0\ub2a5\uc801\uc73c\ub85c \uc6b4\uc601\ud558\ub294 \ubbf8\ub798 \uae30\uc220\uc744 \uc5f0\uad6c\ud569\ub2c8\ub2e4.\n\uc5f0\uc138\ub300\ud559\uad50 \uac74\uc124\ud658\uacbd\uacf5\ud559\uacfc\ub294 \uc9c0\uad6c\ub97c \ub118\uc5b4 \uc6b0\uc8fc \uacf5\uac04\uae4c\uc9c0 \ud655\uc7a5\ub418\ub294 \uc778\ud504\ub77c \uae30\uc220\uc744 \uc120\ub3c4\ud558\uba70, \uc0ac\ud68c\uc801 \uacf5\uacf5\uc131\uc744 \ubc14\ud0d5\uc73c\ub85c \uc778\ub958\uc758 \uc548\uc804\uacfc \ud3b8\uc758\ub97c \ucc45\uc784\uc9d1\ub2c8\ub2e4. \ud559\uc0dd\ub4e4\uc740 \ubcf8 \ud559\uacfc\uc758 \uccb4\uacc4\uc801\uc778 \uc804\uacf5 \uacfc\uc815\uc744 \ud1b5\ud574 \uc9c0\uc18d\uac00\ub2a5\ud558\uace0(Sustainable), \ud68c\ubcf5 \ud0c4\ub825\uc801\uc774\uba70(Resilient), \uc9c0\ub2a5\uc801\uc778(Smart) \ubbf8\ub798 \uc0ac\ud68c\ub97c \ub514\uc790\uc778\ud558\ub294 \ucc3d\uc758\uc801\uc778 \uae00\ub85c\ubc8c \uc778\uc7ac\ub85c \uc131\uc7a5\ud558\uac8c \ub429\ub2c8\ub2e4.\n\uac1c\uc778\uc815\ubcf4\ucc98\ub9ac\ubc29\uce68\n\ubc95\uc801\uace0\uc9c0\n(03722) \uc11c\uc6b8\ud2b9\ubcc4\uc2dc \uc11c\ub300\ubb38\uad6c \uc5f0\uc138\ub85c 50 \uc5f0\uc138\ub300\ud559\uad50 \uacf5\uacfc\ub300\ud559\ncopyrights (C) 2020 YONSEI UNIVERSITY College of Engineering. All rights reserved\n\uad50\ub0b4\uc8fc\uc694\uc0ac\uc774\ud2b8\n\uad50\ubaa9\uc2e4\n\uad6d\uc81c\ucc98\n\ub9ac\ub354\uc2ed\uc13c\ud130\n\uc5f0\uad6c\ucc98/\uc0b0\ud559\ud6