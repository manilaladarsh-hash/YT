8/\uc5f0\uad6c\n\ud559\uc0ac/\uad50\uc721\n\uc785\ud559/\uad50\uc721\uc0dd\n\ucee4\ubba4\ub2c8\ud2f0\n\ud559\uc0ac\uc548\ub0b4\n\ud559\uc0ac\uc548\ub0b4\n\uac1c\uc124\uad50\uacfc\ubaa9\n\ub300\ud559\uc6d0\uc0dd\ud65c\n\uc7a5\ud559\uc81c\ub3c4\n\uc9c0\ub3c4\uad50\uc218\uc120\uc815\n\ud559\uc0ac\uc77c\uc815\n\ub4f1\ub85d/\ud559\uc801\n\uc218\uac15\uc2e0\uccad\n\uc9c0\ub3c4\uad50\uc218\uc120\uc815\n\ud559\uc704\uc774\uc218\uc694\uac74\n\ud559\uc704\ub17c\ubb38\uc81c\ucd9c\n\uc9c0\ub3c4\uad50\uc218 \uc120\uc815 \uc2dc\uae30 :\n\uc785\ud559 \ud6c4 2\uac1c\uc6d4 \ub0b4\uc5d0 \uacb0\uc815\ud55c\ub2e4.\n\ud76c\ub9dd\uc9c0\ub3c4\uad50\uc218\uc2e0\uccad :\n\uc758\uacfc\ud559\uacfc \uc18c\uc18d \uad50\uc218 \uc911\uc5d0\uc11c \ud76c\ub9dd \uc9c0\ub3c4\uad50\uc218 3\uc778\uc744 \uc120\ud0dd\ud558\uace0 \ud76c\ub9dd \uc21c\uc704(1, 2, 3)\uc640 \ud568\uaed8 \uc9c0\ub3c4 \uad50\uc218 \uc120\uc815 \uc2e0\uccad\uc11c\uc5d0 \uae30\uc785\ud558\uc5ec \uc758\uacfc\ud559\uacfc\uc5d0 \uc81c\ucd9c\ud55c\ub2e4.\n\uc9c0\ub3c4\uad50\uc218\uc120\uc815 \uc2e0\uccad\uc11c \uc81c\ucd9c :\n\uc2e0\uccad\uc11c \uc81c\ucd9c\uc740 \ub9e4 \ud559\ub144\ub3c4 3\uc6d4\ucd08, 9\uc6d4 \ucd08\uc5d0 \uc81c\ucd9c\ud558\uba70 \uc81c\ucd9c \uc790\ub8cc\ub97c \uac00\uc9c0\uace0 \ub300\ud559\uc6d0 \ud559\uc0ac\uc704\uc6d0\ud68c\ub97c \uac1c\ucd5c\ud558\uc5ec \uc9c0\ub3c4\uad50\uc218\ub97c \uc120\uc815\ud558\uc5ec \ud1b5\ubcf4\ud55c\ub2e4.\n\uc9c0\ub3c4\uad50\uc218 \uc790\uaca9 :\n\uc9c0\ub3c4\uad50\uc218\ub294 \uc758\uacfc\ud559\uacfc \uc18c\uc18d \uad50\uc218\uc774\uc5b4\uc57c \ud558\uba70, \ubc15\uc0ac\ud559\uc704\ub97c \uc18c\uc9c0\ud55c \uc870\uad50\uc218(\uae30\uae08\uc870\uad50\uc218 \ud3ec\ud568) \uc774\uc0c1\uc73c\ub85c \ud55c\ub2e4.\n\uc9c0\ub3c4\uad50\uc218 \ubcc0\uacbd :\n\uc9c0\ub3c4\uad50\uc218 \ubcc0\uacbd\uc740 \uc785\ud559 \ud6c4 1\ub144 \uc774\ub0b4\uc5d0 \ubcc0\uacbd \uc804 \uad50\uc218\uc640 \ubcc0\uacbd \ud6c4 \uad50\uc218 \uc591\ucabd\uc758 \uc2b9\uc778\uc5d0 \uc758\ud574 \uac00\ub2a5\ud558\ub2e4.\n(\ud559\uce59 \uc810\uac80). \ucc9c\uc7ac\uc9c0\ubcc0 \ud639\uc740 \uc9c0\ub3c4\uad50\uc218\uc758 \uc774\uc9c1\uc5d0 \uc758\ud55c \ubcc0\uacbd\uc740 1\ub144 \uc774\ud6c4\uc5d0\ub3c4 \uac00\ub2a5\ud558\ub2e4.\n\uc784\uc2dc\uc9c0\ub3c4\uad50\uc218 :\n\uc9c0\ub3c4\uad50\uc218\uac00 \uacb0\uc815\ub418\uae30 \uc804\uae4c\uc9c0 \uc2e0\uc785\uc0dd\uc758 \ud559\uc0ac\uc9c0\ub3c4\ub294 \uc784\uc2dc \uc9c0\ub3c4\uad50\uc218\uc758 \uc790\uaca9\uc73c\ub85c \uc758\uacfc\ud559\uacfc \ud559\uacfc\uc7a5\uc774 \ub2f4\ub2f9\ud55c\ub2e4.\n\uc5f0\uad6c\uc2e4 \uc21c\ud658\uc2e4\uc2b5 (Lab rotation) :\n\uc11d\ubc15\ud1b5\ud569 \uc2e0\uc785\uc0dd\uc758 \uacbd\uc6b0 \uc758\uacfc\ud559\uacfc \ub0b4 2~3\uac1c \uc5f0\uad6c\uc2e4\uc744 \uc21c\ud658\ud558\ub294 \uc5f0\uad6c\uc2e4 \uc21c\ud658\uc2e4\uc2b5\uc5d0 \ucc38\uc5ec\ud55c\ub2e4. \uc774\ub97c \ud1b5\ud574 \uc758\uacfc\ud559\uacfc \ub0b4 \ub2e4\uc591\ud55c \uc5f0\uad6c\uc2e4\uc744 \uacbd\ud5d8\ud558\uace0, \uc9c0\ub3c4\uad50\uc218\ub97c \uacb0\uc815\ud558\uc9c0 \ubabb\ud55c \ud559\uc0dd\ub4e4\uc740 \uc9c0\ub3c4\uad50\uc218 \ud0d0\uc0c9\uc758 \uae30\ud68c\ub85c \ud65c\uc6a9\ud560 \uc218 \uc788\ub2e4.\n\uc5f0\uad6c\uc2e4 \uc21c\ud658\uc2e4\uc2b5 \uc5f0\uad6c\uc2e4 \uc120\uc815 :\n\ud569\uaca9\uc790 \ubc1c\ud45c \uc9c1\ud6c4 (2\uc6d4, 8\uc6d4), \uc548\ub0b4\uc5d0 \ub530\ub77c \uc21c\ud658\uc2e4\uc2b5 \uc2e0\uccad\uc11c\ub97c \uc758\uacfc\ud559\uacfc\uc5d0 \uc81c\ucd9c\ud558\uba74 \uac1c\uac15 \uc804 \uc5f0\uad6c\uc2e4\uc744 \ubc30\uc815\ubc1b\ub294\ub2e4.\n\uc5f0\uad6c\uc2e4 \uc21c\ud658\uc2e4\uc2b5 \uc2dc\uae30 :\n\uc785\ud559 \ud6c4 2\uac1c\uc6d4\uac04 (3-4\uc6d4, 9-10\uc6d4) \uc2dc\ud589\ud558\uace0, \uc2e0\uc785\uc0dd \ud544\uc218\uad50\uacfc\ubaa9\uc778 '\uc758\uacfc\ud559\uac15\ub3c5'\uacfc \ubcd1\ud589\ud558\uc5ec \uc2e4\uc2dc\ud55c\ub2e4.\nENGLISH\n\ud559\uacfc\uc18c\uac1c\n\ud559\uacfc\uc7a5 \uc778\uc0ac\ub9d0\n\uad50\uc721\ubaa9\ud45c\n\ud559\uacfc\uc5ed\uc0ac\n\uc5f0\ud601\n\uc5ed\ub300\ud559\uacfc\uc7a5\n\ud559\uc0dd\ud604\u