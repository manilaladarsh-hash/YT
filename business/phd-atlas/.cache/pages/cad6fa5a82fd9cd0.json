610\ub294 \uc6b0\ud3b8 \uc81c\ucd9c\n3. \uc218\ud5d8\ud45c \ucd9c\ub825\n2026. 10. 6.(\ud654) ~\n\uc785\ud559\ud648\ud398\uc774\uc9c0 - [\uc77c\ubc18\ub300\ud559\uc6d0 \uacf5\uc9c0\uc0ac\ud56d ]\n\uba74\uc811 \ubc0f \uad6c\uc220\uace0\uc0ac \uc2dc \uc9c0\ucc38\n4. \uba74\uc811 \ubc0f \uad6c\uc220\uace0\uc0ac\n2026. 10. 12.(\uc6d4) 13:00 ~\n(\u203b \uc2dc\uc791\uc2dc\uac04 \ubcc0\ub3d9 \uac00\ub2a5\uc131 \uc788\uc74c)\n203\ub3d9 208\ud638\n5. \ud569\uaca9\uc790 \ubc1c\ud45c\n2026. 11. 19.(\ubaa9) 18:00 \uc774\ud6c4\n\uc785\ud559 \ud648\ud398\uc774\uc9c0-\uc77c\ubc18\ub300\ud559\uc6d0 \uacf5\uc9c0\uc0ac\ud56d (admission.snu.ac.kr)\n6. \ud569\uaca9\uc790 \ub4f1\ub85d\n2027. 2. 1.(\uc6d4) 10:00 ~ 2. 5.(\uae08) 16:00\n\uc804\uad6d \ub18d\ud611, \uc2e0\ud55c\uc740\ud589, \uc6b0\ub9ac\uc740\ud589 \uc9c0\uc810 (\uc778\ud130\ub137\u00b7\uc2a4\ub9c8\ud2b8\ud3f0 \ubc45\ud0b9 \uac00\ub2a5)\n\uc785\ud559\ud648\ud398\uc774\uc9c0 - [\uc77c\ubc18\ub300\ud559\uc6d0 \uacf5\uc9c0\uc0ac\ud56d ] \uc5d0\uc11c \ub4f1\ub85d\uae08\uace0\uc9c0\uc11c\ub97c \ucd9c\ub825\ud558\uc5ec \ub0a9\ubd80\n\uc0c1\uae30 \uc77c\uc815\uc740 \ud559\uc0ac\uc77c\uc815 \ub4f1\uc5d0 \ub530\ub77c \ubcc0\uacbd\ub420 \uc218 \uc788\uc74c\n\uc9c0\uc6d0\uc790\uaca9\n\uc11d\uc0ac\uacfc\uc815\u00b7\uc11d\uc0ac\ubc15\uc0ac\ud1b5\ud569\uacfc\uc815\n\uad6d\ub0b4\u00b7\uc678\uc5d0\uc11c \ud559\uc0ac\ud559\uc704\ub97c \ucde8\ub4dd\ud55c \uc790[2027\ub144 2\uc6d4(\uad6d\uc678\ub300\ud559 \uc878\uc5c5\uc790\ub294 2027\ub144 3\uc6d4)\uae4c\uc9c0\n\ucde8\ub4dd \uc608\uc815\uc790 \ud3ec\ud568] \ub610\ub294 \ubc95\ub839\uc5d0 \ub530\ub77c \ud559\uc0ac\ud559\uc704 \uc774\uc0c1\uc758 \ud559\ub825\uc774 \uc788\ub2e4\uace0 \uc778\uc815\ub41c \uc790\nTEPS \ub610\ub294 TOEFL \uc815\uae30\uc2dc\ud5d8\uc5d0\uc11c \ubaa8\uc9d1 \ub2e8\uc704\ubcc4\ub85c \uc815\ud55c \uc77c\uc815 \uc810\uc218 \uc774\uc0c1\uc758 \uc131\uc801\uc744 \ucde8\ub4dd\ud55c \uc790\n\uc9c0\uc6d0\uac00\ub2a5 \uc601\uc5b4\uc810\uc218 (2027\ud559\ub144\ub3c4 \uae30\uc900)\nDrag from side to side.\nTEPS \uc810\uc218\nTOEFL/IBT\n\ud559\uacfc(\ubd80)\n\uac1c\uc815 TEPS : 327\uc810 \uc774\uc0c1 (\uae30\uc874 TEPS: 601\uc810 \uc774\uc0c1)\n96\uc810(5.0) \uc774\uc0c1\n\ub1cc\uc778\uc9c0\uacfc\ud559\uacfc\nTOEFL iBT \uc2dc\ud5d8 \uc751\uc2dc\uc77c\uc774 2026. 1. 21. \uc774\ud6c4\uc778 \uacbd\uc6b0\uc5d0\ub294 \uac1c\uc815\ub41c TOEFL iBT \uc810\uc218 \uccb4\uacc4 \uae30\uc900\uc744 \uc801\uc6a9\ud568\n\uc815\uae30\uc2dc\ud5d8 \uc131\uc801\ub9cc \uc778\uc815\ud568\n\uc778\uc815\ub418\ub294 \uc601\uc5b4\uc131\uc801\n\uc9c0\uc6d0\uc11c \uc811\uc218 \ub9c8\uac10\uc77c(2026. 10. 2.) \uae30\uc900 2\ub144 \uc774\ub0b4\uc5d0 \uc751\uc2dc\ud558\uace0 \ubc1c\ud45c\uac00 \uc644\ub8cc\ub418\uc5b4 \uc785\ud559\uc9c0\uc6d0\uc11c\uc5d0 \uae30\uc7ac\ub41c \uc815\uae30\uc2dc\ud5d8 \uc131\uc801(TOEFL My Best Scores* \ubc0f Home Edition \uc131\uc801 \ud3ec\ud568)\n\ubcf8\uad50 \uc11d\uc0ac\ud559\uc704\uc790\uac00 \ubcf8\uad50 \ub300\ud559\uc6d0 \uc785\ud559 \uc2dc \ub610\ub294 \ub17c\ubb38 \uc81c\ucd9c \uc790\uaca9\uc2dc\ud5d8\uc5d0\uc11c \uc778\uc815\ubc1b\uc740 \uc131\uc801\n\uc9c0\uc6d0\uc11c \uc811\uc218 \ub9c8\uac10\uc77c(2026. 10. 2.) \uae30\uc900 10\ub144 \uc774\ub0b4 \uc751\uc2dc \uc131\uc801\uae4c\uc9c0 \uc778\uc815\ud558\uba70, \ud574\ub2f9 \uc131\uc801(\uc751\uc2dc \ud68c\ucc28 \ubc0f \uc810\uc218) \uc744 \uc785\ud559\uc9c0\uc6d0\uc11c\uc5d0 \uae30\uc7ac\ud574\uc57c \ud568(\uc18c\uc18d \ub2e8\uacfc\ub300\ud559 \uad50\ubb34\ud589\uc815\uc2e4\uc5d0 \ubb38\uc758)\n\ud574\ub2f9 \uc810\uc218\ub294 \ud604\ud589 \uc9c0\uc6d0 \uac00\ub2a5 \uacf5\uc778 \uc601\uc5b4\uc2dc\ud5d8\uc131\uc801 \uae30\uc900\uc744 \ucda9\uc871\ud574\uc57c \ud568\n\uc601\uc5b4\uad8c \uad6d\uac00 \uc18c\uc7ac \ub300\ud559(\uc6d0) \uc878\uc5c5(\uc608\uc815)\uc790\n\uac01 \ub300\ud559(\uc6d0) \uc804\ud615 \uc704\uc6d0\ud68c \uc2ec\uc0ac \uacb0\uacfc\uc5d0 \ub530\ub77c \uc601\uc5b4\uc131\uc801 \uc81c\ucd9c\uc744 \uba74\uc81c\ud560 \uc218 \uc788\uc74c\n\uac01 \ub300\ud559(\uc6d0)\ub9c8\ub2e4 \uc601\uc5b4\uc131\uc801 \uc81c\ucd9c\uc774 \uba74\uc81c\ub418\ub294 \uc601\uc5b4\uad8c \uad6d\uac00\uac00 \ub2e4\ub97c \uc218 \uc788\uc73c\ub2c8, \uc9c0\uc6d0 \uc608\uc815 \ub300\ud559(\uc6d0)\uc5d0 \uc5f0\ub77d\ud558\uc5ec \ud655\uc778\ud574\uc57c \ud558\uba70, \uc601\uc5b4\uc131\uc801 \uc81c\ucd9c\uc774 \uba74\uc81c\ub41c \ucd5c\uc885 \ud569\uaca9\uc790\ub294 \ud574\ub2f9 \uc601\uc5b4\uad8c \uad6d\uac00 \uc18c\uc7ac \ub300\ud559(\uc6d0)\uc758 \uc878\uc5c5(\ud559\uc704)\uc99d\uba85\uc11c \ubc0f \ud574\ub2f9 \uc99d\uba85\uc11c\uc5d0 \ub300\ud55c \uc544\ud3ec\uc2a4\ud2f0\uc720 \ub610\ub294 \uc601\uc0ac \ud655\uc778\uc744 \uc81c\ucd9c\ud574\uc57c \ud568\n\"\uc601\uc5b4\uad8c \uad6d\uac00\"\ub294 \uc601\uc5b4\uac00 \ubaa8\uad6d\uc5b4\uc774\uac70\ub098 \ubc95\uc815 \uacf5\uc6a9\uc5b4\uc778 \uad6d\uac00\ub97c \ub73b\ud558\uba70, \ud55c\uad6d \uc18c\uc7ac \ub300\ud559(\uc6d0)\uc740 \ud3ec\ud568\ub418\uc9c0 \uc54a\uc74c\n\ubc15\uc0ac\uacfc\uc815\n\uad6d\ub0b4\u00b7\uc678\uc5d0\uc11c \uc11d\uc0ac\ud559\uc704\ub97c \ucde8\ub4dd\ud55c \uc790[2027\ub144 2\uc6d4(\uad6d\uc678\ub300\ud559 \uc878\uc5c5\uc790\ub294 2027\ub144 3\uc6d4)\uae4c\uc9c0\n\ucde8\ub4dd \uc608\uc815\uc790 \ud3ec\ud568] \ub610\ub294 \ubc95\ub839\uc5d0 \ub530\ub77c \uc11d\uc0ac\ud559\uc704 \uc774\uc0c1\uc758 \ud559\ub825\uc774 \uc788\ub2e4\uace0 \uc778\uc815\ub41c \uc790\n\ubaa8\uc9d1 \ub2e8\uc704\ubcc4 \ub3d9\uc885\uacc4\uc5f4 \uc9c0\uc815 \uae30\uc900\uc744 \ucda9\uc871\ud55c \uc790\nTEPS \ub610\ub294 TOEFL \uc815\uae30\uc2dc\ud5d8\uc5d0\uc11c \ubaa8\uc9d1 \ub2e8\uc704\ubcc4\ub85c \uc815\ud55c \uc77c\uc815 \uc810\uc218 \uc774\uc0c1\uc758 \uc131\uc801\uc744 \ucde8\ub4dd\ud55c \uc790\n\uc9c0\uc6d0\uac00\ub2a5 \uc601\uc5b4\uc810\uc218\nDrag from side to side.\nTEPS \uc810\uc218\nTOEFL/IBT\n\ud559\uacfc(\ubd80)\n\uac1c\uc815 TEPS : 327\uc810 \uc774\uc0c1 (\uae30\uc874 TEPS: 601\uc810 \uc774\uc0c1)\n96\uc810(5.0) \uc774\uc0c1\n\ub1cc\uc778\uc9c0\uacfc\ud559\uacfc\nTOEFL iBT \uc2dc\ud5d8 \uc751\uc2dc\uc77c\uc774 2026. 1. 21. \uc774\ud6c4\uc778 \uacbd\uc6b0\uc5d0\ub294 \uac1c\uc815\ub41c TOEFL iBT \uc810\uc218 \uccb4\uacc4 \uae30\uc900\uc744 \uc801\uc6a9\ud568\n\uc815\uae30\uc2dc\ud5d8 \uc131\uc801\ub9cc \uc778\uc815\ud568\n\uc778\uc815\ub418\ub294 \uc601\uc5b4\uc131\uc801\n\uc9c0\uc6d0\uc11c \uc811\uc218 \ub9c8\uac10\uc77c(2026. 10. 2.) \uae30\uc900 2\ub144 \uc774\ub0b4\uc5d0 \uc751\uc2dc\ud558\uace0 \ubc1c\ud45c\uac00 \uc644\ub8cc\ub418\uc5b4 \uc785\ud559\uc9c0\uc6d0\uc11c\uc5d0 \uae30\uc7ac\ub41c \uc815\uae30\uc2dc\ud5d8 \uc131\uc801(TOEFL My Best Scores* \ubc0f Home Edition \uc131\uc801 \ud3ec\ud568)\n\ubcf8\uad50 \uc11d\uc0ac\ud559\uc704\uc790\uac00 \ubcf8\uad50 \ub300\ud559\uc6d0 \uc785\ud559 \uc2dc \ub610\ub294 \ub17c\ubb38 \uc81c\ucd9c \uc790\uaca9\uc2dc\ud5d8\uc5d0\uc11c \uc778\uc815\ubc1b\uc740 \uc131\uc801 \uc9c0\uc6d0\uc11c \uc811\uc218 \ub9c8\uac10\uc77c(2026. 10. 2.) \uae30\uc900 10\ub144 \uc774\ub0b4 \uc751\uc2dc \uc131\uc801\uae4c\uc9c0 \uc778\uc815\ud558\uba70, \ud574\ub2f9 \uc131\uc801(\uc751\uc2dc \ud68c\ucc28 \ubc0f \uc810\uc218) \uc744 \uc785\ud559\uc9c0\uc6d0\uc11c\uc5d0 \uae30\uc7ac\ud574\uc57c \ud568(\uc18c\uc18d \ub2e8\uacfc\ub300\ud559 \uad50\ubb34\ud589\uc815\uc2e4\uc5d0 \ubb38\uc758) \ud574\ub2f9 \uc810\uc218\ub294 \ud604\ud589 \uc9c0\uc6d0 \uac00\ub2a5 \uacf5\uc778 \uc601\uc5b4\uc2dc\ud5d8\uc131\uc801 \uae30\uc900\uc744 \ucda9\uc871\ud574\uc57c \ud568\n\uc601\uc5b4\uad8c \uad6d\uac00 \uc18c\uc7ac \ub300\ud559(\uc6d0) \uc878\uc5c5(\uc608\uc815)\uc790\n\uac01 \ub300\ud559(\uc6d0) \uc804\ud615 \uc704\uc6d0\ud68c \uc2ec\uc0ac \uacb0\uacfc\uc5d0 \ub530\ub77c \uc601\uc5b4\uc131\uc801 \uc81c\ucd9c\uc744 \uba74\uc81c\ud560 \uc218 \uc788\uc74c\n\uac01 \ub300\ud559(\uc6d0)\ub9c8\ub2e4 \uc601\uc5b4\uc131\uc801 \uc81c\ucd9c\uc774 \uba74\uc81c\ub418\ub294 \uc601\uc5b4\uad8c \uad6d\uac00\uac00 \ub2e4\ub97c \uc218 \uc788\uc73c\ub2c8, \uc9c0\uc6d0 \uc608\uc815 \ub300\ud559(\uc6d0)\uc5d0 \uc5f0\ub77d\ud558\uc5ec \ud655\uc778\ud574\uc57c \ud558\uba70, \uc601\uc5b4\uc131\uc801 \uc81c\ucd9c\uc774 \uba74\uc81c\ub41c \ucd5c\uc885 \ud569\uaca9\uc790\ub294 \ud574\ub2f9 \uc601\uc5b4\uad8c \uad6d\uac00 \uc18c\uc7ac \ub300\ud559(\uc6d0)\uc758 \uc878\uc5c5(\ud559\uc704)\uc99d\uba85\uc11c \ubc0f \ud574\ub2f9 \uc99d\uba85\uc11c\uc5d0 \ub300\ud55c \uc544\ud3ec\uc2a4\ud2f0\uc720 \ub610\ub294 \uc601\uc0ac \ud655\uc778\uc744 \uc81c\ucd9c\ud574\uc57c \ud568\n\"\uc601\uc5b4\uad8c \uad6d\uac00\"\ub294 \uc601\uc5b4\uac00 \ubaa8\uad6d\uc5b4\uc774\uac70\ub098 \ubc95\uc815 \uacf5\uc6a9\uc5b4\uc778 \uad6d\uac00\ub97c \ub73b\ud558\uba70, \ud55c\uad6d \uc18c\uc7ac \ub300\ud559(\uc6d0)\uc740 \ud3ec\ud568\ub418\uc9c0 \uc54a\uc74c\n\uba74\uc811 \ubc0f \uad6c\uc220\uace0\uc0ac\n\uc77c\uc2dc \ubc0f \uc7a5\uc18c : 2026. 10. 12.(\uc6d4) 13:00 ~ (\u203b \uc2dc\uc791\uc2dc\uac04 \ubcc0\ub3d9 \uac00\ub2a5\uc131 \uc788\uc74c) (\uc7a5\uc18c: 203\ub3d9 208\ud638)\n\ud654\uc0c1\uba74\uc811 \uad00\ub828 \uc548\ub0b4 :\n\uc678\uad6d \uac70\uc8fc\uc790 \ub610\ub294 \ud2b9\uc218\uc0c1\ud669\uc5d0 \uc788\ub294 \uc790\uc5d0 \ud55c\ud558\uc5ec \uc9c0\uc6d0\uc11c \uc811\uc218 \uc2dc \ud654\uc0c1 \uba74\uc811\uc744 \uc2e0\uccad\ud560 \uc218 \uc788\uc74c. \ub2e8, \ud654\uc0c1 \uba74\uc811\uc9c4\ud589 \uc5ec\ubd80\ub294 \uc9c0\uc6d0 \ubaa8\uc9d1 \ub2e8\uc704\uac00 \uc18d\ud55c \ub300\ud559(\uc6d0)\uc5d0\uc11c \uacb0\uc815\ud558\ubbc0\ub85c \ubc18\ub4dc\uc2dc \uc0ac\uc804\uc5d0 \ud574\ub2f9 \ub300\ud559(\uc6d0)\uacfc \ud611\uc758\ud558\uc5ec\uc57c \ud568\n\ud654\uc0c1 \uba74\uc811\uc5d0 \uc751\uc2dc\ud558\uc5ec \ud569\uaca9\ud55c \uc790\ub294 \ucd94\ud6c4 \uc99d\ube59\uc790\ub8cc(\ucd9c\uc785\uad6d\uc0ac\uc2e4\uc99d\uba85\uc11c, \uc9c4\ub2e8\uc11c \ub4f1)\ub97c \uc81c\ucd9c\ud558\uc5ec\uc57c \ud558\uba70, \ud5c8\uc704 \uc0ac\uc720\ub098 \ud0c0\uc778\uc5d0 \uc758\ud55c \uba74\uc811 \ub4f1 \ubd80\uc815\ud55c \ubc29\ubc95\uc73c\ub85c \ud654\uc0c1 \uba74\uc811\uc5d0 \uc751\uc2dc\ud55c \uacbd\uc6b0 \ud569\uaca9 \ub610\ub294 \uc785\ud559\uc744 \ucde8\uc18c\ud568\n\uc9c0\uc6d0\uc11c \uc811\uc218(\uc778\ud130\ub137)\n\uc77c\uc2dc\n2026. 9. 28.(\uc6d4) 10:00 ~ 10. 2.(\uae08) 17:00\n\uc811\uc218\ubc29\ubc95\n\uc11c\uc6b8\ub300\ud559\uad50 \uc785\ud559\ud648\ud398\uc774\uc9c0 - [\uc77c\ubc18\ub300\ud559\uc6d0 \uacf5\uc9c0\uc0ac\ud56d\uc5d0\uc11c \ud655\uc778 ]\n\uc720\uc758\uc0ac\ud56d\n\uc9c0\uc6d0\uc11c \uc811\uc218\ub9c8\uac10\uc2dc\uac04[2026. 10. 2.(\uae08)] 17:00\uae4c\uc9c0 \uc804\ud615\ub8cc \uacb0\uc81c\ub97c \uc644\ub8cc\ud558\uc5ec\uc57c \uc811\uc218\uac00 \uc778\uc815\ub418\uba70, \ucd94\uac00 \uc811\uc218\ub294 \uc9c4\ud589\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uc811\uc218\uae30\uac04 \uc911 \uc9c0\uc6d0\uc790\uc758 \uc811\uc18d\ud658\uacbd \ub4f1\uc744 \ubbf8\ub9ac \ud655\uc778\ud558\uc2dc\uae30 \ubc14\ub78d\ub2c8\ub2e4.\n\uc9c0\uc6d0\uc11c \uc811\uc218(\uc804\ud615\ub8cc \uacb0\uc81c) \uc644\ub8cc \ud6c4\uc5d0\ub294 \uacfc\uc815 \ubc0f \ubaa8\uc9d1\ub2e8\uc704\ub97c \ubcc0\uacbd\ud560 \uc218 \uc5c6\uc73c\uba70, \uc811\uc218\ucde8\uc18c \ubc0f \uc804\ud615\ub8cc \ud658\ubd88\uc774 \ubd88\uac00\ud558\ubbc0\ub85c, \uc811\uc218 \uc2dc \ubaa8\uc9d1\uc548\ub0b4 \ub4f1 \uc9c0\uc6d0\uc5d0 \ud544\uc694\ud55c \uc0ac\ud56d\uc744 \ubc18\ub4dc\uc2dc \ud655\uc778\ud55c \ud6c4 \uc9c0\uc6d0\uc11c\ub97c \uc791\uc131\ud558\uc2dc\uae30\ubc14\ub78d\ub2c8\ub2e4.\n\uac1c\uc778\uc778\uc801\uc0ac\ud56d, \uc790\uae30\uc18c\uac1c\uc11c\ub294 \uc811\uc218\ub9c8\uac10 \uc2dc\uae4c\uc9c0 \uc218\uc815 \uac00\ub2a5\n\uc81c\ucd9c \uc11c\ub958\n\uacf5\ud1b5\uc11c\ub958\nDrag from side to side.\n\uad6c\ubd84\n\uc81c\ucd9c\ubc29\ubc95\n\uc81c\ucd9c\uae30\ud55c\n\ube44\uace0\n\uc785\ud559\uc9c0\uc6d0\uc11c\n\uc778\ud130\ub137 \uc811\uc218\n\uc811\uc218\ub9c8\uac10\uc2dc\uac04\n-\n\uc790\uae30\uc18c\uac1c\uc11c \ubc0f \uc218\ud559\uacc4\ud68d\uc11c\n\uc9c0\uc6d0\uc11c \uc791\uc131\uc2dc \uc5c5\ub85c\ub4dc\n\uc811\uc218\ub9c8\uac10\uc2dc\uac04\n\uacf5\ud1b5\uc11c\uc2dd \ub610\ub294 \ubaa8\uc9d1\ub2e8\uc704\ubcc4 \uc18c\uc815 \uc11c\uc2dd \uc0ac\uc6a9 (\uc11c\uc6b8\ub300\ud559\uad50 \uc785\ud559\ud648\ud398\uc774\uc9c0\uc5d0\uc11c \ub2e4\uc6b4\ub85c\ub4dc)\n\ud559\uc0ac\uacfc\uc815 \uc804\ud559\ub144 \uc131\uc801\uc99d\uba85\uc11c\n(\ubc15\uc0ac\uacfc\uc815 \uc9c0\uc6d0\uc790 : \uc11d\uc0ac\uacfc\uc815 \uc131\uc801\uc99d\uba85\uc11c \ucd94\uac00 \uc81c\ucd9c)\n\uc9c1\uc811(\uc6b0\ud3b8)\uc81c\ucd9c\n2026. 10. 6.(\ud654)\n2027\ub144 2\uc6d4 \uc878\uc5c5\uc608\uc815\uc790: 2026\ud559\ub144\ub3c4 1\ud559\uae30 \uc131\uc801\uae4c\uc9c0 \uae30\uc7ac\ub41c \uc131\uc801\ud45c\n\ubcf8\uad50 \uc878\uc5c5\uc0dd\uc740 \uc81c\ucd9c \uc0dd\ub7b5 \uac00\ub2a5\ud558\ub098, \ubaa8\uc9d1\ub2e8\uc704\ubcc4\ub85c \uc9c0\uc815\ud55c \uacbd\uc6b0\uc5d0\ub294 \uc81c\ucd9c\n\ud3b8\uc785\uc0dd\uc740 \uc804\uc801\ub300\ud559 \uc790\ub8cc \ud3ec\ud568\ud558\uc5ec \uc81c\ucd9c\n\uacf5\uc778\uc601\uc5b4\uc131\uc801\ud45c(TEPS)\n\uc81c\ucd9c\ud558\uc9c0 \uc54a\uc74c\n-\nTEPS \uc131\uc801\uc740 \uc11c\uc6b8\ub300\ud559\uad50\uc5d0\uc11c \uc870\ud68c\ud568\n\uacf5\uc778\uc601\uc5b4\uc131\uc801\ud45c(TOEFL)\n\uc9c1\uc811(\uc6b0\ud3b8)\uc81c\ucd9c\n2026. 10. 6.(\ud654)\n\uc218\ud5d8\ubc88\ud638 \ubc0f \uc601\uc5ed\ubcc4 \uc810\uc218\uac00 \ud45c\uc2dc\ub41c \uc131\uc801\ud45c\n\uc81c\ucd9c\ucc98(\uc6b0\ud3b8\uc774\uc6a9 \uc2dc)\nDrag from side to side.\n\uc8fc\uc18c\n\uc5f0\ub77d\ucc98\n\ud648\ud398\uc774\uc9c0\n\uc11c\uc6b8\ud2b9\ubcc4\uc2dc \uad00\uc545\uad6c \uad00\uc545\ub85c 1 \uc11c\uc6b8\ub300\ud559\uad50 \uc790\uc5f0\uacfc\ud559\ub300\ud559 \uad50\ud559\ud589\uc815\uc2e4 \ubc31\uc724\uc815 \uadc0\ud558 (\uc6b0: 08826)\n(Tel) 02-880-6508\n(Fax) 02-876-4117\nhttps://science.snu.ac.kr\n\uc81c\ucd9c\uae30\ud55c\n2026. 10. 6.(\ud654) 17:00\uae4c\uc9c0 \u261e \uc9c0\uc6d0 \ubaa8\uc9d1\ub2e8\uc704 \uc18c\uc18d \ub300\ud559(\uc6d0) \uad50\ubb34\ud589\uc815\uc2e4\ub85c \uc81c\ucd9c\n\ud569\uaca9\uc790 \ubc1c\ud45c\n\uc77c\uc2dc : 2026. 11. 19.(\ubaa9) 18:00 \uc774\ud6c4\n\uc7a5\uc18c : \uc11c\uc6b8\ub300\ud559\uad50 \uc785\ud559 \ud648\ud398\uc774\uc9c0(http://admission.snu.ac.kr ) (\uc11c\uc6b8\ub300\ud559\uad50 \u21d2 \uc785\ud559 \u21d2 \uc77c\ubc18\ub300\ud559\uc6d0 \uacf5\uc9c0\uc0ac\ud56d \u21d2 \ud569\uaca9\uc790\ubc1c\ud45c \u21d2 \uc131\uba85, \uc0dd\ub144\uc6d4\uc77c\uacfc \uc218\ud5d8\ubc88\ud638\ub85c \uac80\uc0c9)\n\uc9c0\uc6d0\uc790 \uc720\uc758\uc0ac\ud56d\n2\uac1c \uc774\uc0c1\uc758 \ubaa8\uc9d1\ub2e8\uc704\uc5d0 \uc911\ubcf5 \uc9c0\uc6d0\ud560 \uc218 \uc5c6\uc73c\uba70, \uc911\ubcf5 \uc9c0\uc6d0 \uc2dc \uc804\uccb4 \ubaa8\uc9d1\ub2e8\uc704\uc5d0 \ub300\ud558\uc5ec \ubd88\ud569\uaca9 \ucc98\ub9ac\ub429\ub2c8\ub2e4.\nApplicants are not permitted to apply to more than one department during current admission (paying application fee and receiving their application number more than once) and will be disqualified for all applications if found doing so.\n\uc9c0\uc6d0\uc778\uc6d0\uc774 \ubaa8\uc9d1\uc778\uc6d0\uc5d0 \ubbf8\ub2ec\ud558\ub354\ub77c\ub3c4 \uc218\ud559\uc5d0 \uc9c0\uc7a5\uc774 \uc788\ub2e4\uace0 \ud310\ub2e8\ub418\ub294 \uc790\uc5d0 \ub300\ud558\uc5ec\ub294 \uc120\ubc1c\ud558\uc9c0 \uc54a\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\nEven if the number of applicants falls short of the admissions quota, those who are judged to have difficulties in studying may not be selected.\n\uc785\ud559\uace0\uc0ac \uc131\uc801\uc740 \uacf5\uac1c\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.\nThe Admissions Test scores will not be disclosed.\n\uc811\uc218\ub41c \uc785\ud559\uc9c0\uc6d0\uc11c \ubc0f \uc11c\ub958(\uc778\ud130\ub137 \uc81c\ucd9c \ud3ec\ud568)\ub294 \ucde8\uc18c, \uc815\uc815 \ub610\ub294 \ubc18\ud658(\ud658\ubd88)\ud560 \uc218 \uc5c6\uc73c\uba70, \uc811\uc218\uae30\uac04 \ub9c8\uac10 \uc804\u00b7\ud6c4\uc5d0 \ub3d9\uc77c\ud558\uac8c \uc801\uc6a9\ud569\ub2c8\ub2e4.\nOnce submitted, the application form and all supporting documents (including those submitted online) cannot be canceled, modified, or returned (refunded), and this policy applies equally both before and after the application deadline.\n\uc785\ud559\uc9c0\uc6d0\uc11c \uae30\uc7ac\uc0ac\ud56d \ud5c8\uc704\uae30\uc7ac, \uc11c\ub958\uc758 \uc704\u00b7\ubcc0\uc870 \ubc0f \uae30\ud0c0 \ubd80\uc815\ud55c \ubc29\ubc95\uc73c\ub85c \uc9c0\uc6d0\ud558\uac70\ub098 \ud569\uaca9\ud55c \uc0ac\uc2e4\uc774 \ubc1c\uacac\ub420 \uc2dc \ud569\uaca9 \ubc0f \uc785\ud559\uc744 \ucde8\uc18c\ud558\uba70, \ud5a5\ud6c4 \ubcf8\uad50 \uc785\ud559\uc5d0 \uc81c\ud55c\uc744 \ubc1b\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\nIf it is found that the applicant applied or has been accepted to the University using false information on the application form, forgery of documents, or other fraudulent methods, admission decision will be cancelled and future admission to the University may be restricted.\n\uc218\ud5d8\uc0dd \uc720\uc758\uc0ac\ud56d\uc744 \uc900\uc218\ud558\uc5ec\uc57c \ud558\uace0, \ud2b9\ud788 \ub2f5\uc548\uc9c0\uc758 \ud2b9\uc815 \ubd80\ubd84\uc5d0 \uc778\uc801\uc0ac\ud56d \ub4f1 \uc2e0\ubd84\uc744 \ub178\ucd9c\ud560 \uc218 \uc788\ub294 \uc0ac\ud56d\uc744 \ud45c\uae30\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4.\nCandidates must follow the instructions carefully and should NOT include detailed personal information (names, occupations, etc.) in certain sections of the answer sheet.\n\uc120\ud0dd\uacfc\ubaa9(\uc81c2\uc678\uad6d\uc5b4 \ud3ec\ud568)\uc740 \uc785\ud559\uc9c0\uc6d0\uc11c\uc5d0 \uae30\uc7ac\ud55c \uacfc\ubaa9\uc744 \uc751\uc2dc\ud558\uc5ec\uc57c \ud558\uba70, \uc751\uc2dc\uacfc\ubaa9\uacfc \uc785\ud559\uc9c0\uc6d0\uc11c\uc758 \uc120\ud0dd\uacfc\ubaa9\uc774 \ub2e4\ub97c \uacbd\uc6b0 \uc774\ub97c \ubb34\ud6a8\ub85c \ucc98\ub9ac\ud569\ub2c8\ub2e4.\nFor elective courses (including secondary foreign language), students must take the courses listed on the application form. If students take elective courses other than the ones they listed in the application form, they will be invalidated.\nTEPS, TOEFL \ubc0f \uc81c2\uc678\uad6d\uc5b4\uc2dc\ud5d8 \uc131\uc801 \ubbf8\ub2ec, \uae30\ud0c0 \uacb0\uaca9\uc0ac\uc720\uc5d0 \ud574\ub2f9\ud560 \uacbd\uc6b0\uc5d0\ub3c4 \uc804\ud615\ub8cc \ubc0f \uc81c\ucd9c\uc11c\ub958\ub294 \ubc18\ud658\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.(\ub2e8, \uc804\ud615\ub8cc \ubc18\ud658\uc5d0 \uad00\ud55c \uc0ac\ud56d\uc740 \u201c\uc785\ud559\uc804\ud615\ub8cc \ubc18\ud658\u201d \ucc38\uc870)\nThe application fee and submitted documents will not be returned even if the applicants were rejected due to failure to meet TEPS, TOEFL, or secondary foreign language test scores, or other reasons (Please refer to the section regarding waivers or refunds of application fee)\n\uc81c2\uc678\uad6d\uc5b4\uc2dc\ud5d8 \uc751\uc2dc\uc790\ub294 \uc0ac\uc804\uc744 \uc9c0\ucc38\ud558\uc5ec \ud65c\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.(\ub2e8, \uc804\uc790\uc0ac\uc804\uc740 \ubd88\uac00)\nApplicants who take secondary foreign language test can bring their own dictionary (However, electronic dictionary is not allowed).\n\uc11d\uc0ac\uacfc\uc815 \uc0ac\ubc94\uacc4\uc5f4\uc5d0 \uc785\ud559\ud558\uc5ec \uad50\uc6d0\uc790\uaca9\uc99d \ucde8\ub4dd\uc744 \ud76c\ub9dd\ud558\ub294 \uacbd\uc6b0 \ud559\uc0ac\uacfc\uc815\uc5d0\uc11c \ud45c\uc2dc\uacfc\ubaa9 \uad00\ub828 \ud559\uacfc\ub97c \uc878\uc5c5\ud558\uace0 \uc18c\uc815\uc758 \uc804\uacf5\uacfc\ubaa9\uacfc \uad50\uc9c1\uacfc\ubaa9 \ubc0f 4\uc8fc\uac04\uc758 \ud604\uc7a5\uc2e4\uc2b5\uc744 \uc774\uc218\ud558\uc5ec\uc57c \ud569\ub2c8\ub2e4.(\uad50\uc6d0\uc591\uc131\ud601\uc2e0\uc13c\ud130 \ud648\ud398\uc774\uc9c0 \ucc38\uc870 \ubc0f \uc790\uc138\ud55c \uc0ac\ud56d\uc740 \uc9c0\uc6d0 \ubaa8\uc9d1\ub2e8\uc704(\ud559\uacfc)\ub85c \ubb38\uc758)\nThose who are admitted to Master\u2019s course in College of Education and want to obtain a Teaching Certificate have to obtain a Bachelor\u2019s degree from the related departments, complete relevant major courses and teaching courses, and complete 4 weeks of field experience. (Refer to Link for detailed information and please directly contact corresponding department for any inquiries)\n\ud569\uaca9\uc790\ub85c\uc11c 2027\ub144 2\uc6d4(\uad6d\uc678\ub300\ud559 \uc878\uc5c5\uc790\ub294 2027\ub144 3\uc6d4)\uae4c\uc9c0 \uc2e0\uc785\uc0dd \uc785\ud559\uc790\uaca9\uc744 \uac16\ucd94\uc9c0 \ubabb\ud55c \uacbd\uc6b0 \ub610\ub294 \ud569\uaca9\uc790 \ub4f1\ub85d\uae30\uac04\uc5d0 \ub4f1\ub85d\uc744 \ud558\uc9c0 \uc54a\uac70\ub098 \uc18c\uc815\uc11c\ub958\ub97c \uc81c\ucd9c\ud558\uc9c0 \uc54a\uc740 \uacbd\uc6b0 \ud569\uaca9(\uc785\ud559)\uc744 \ucde8\uc18c\ud569\ub2c8\ub2e4.\nAdmitted applicants who fail to either meet the entrance qualifications, register during the registration period, or submit designated documents by February 2027(March 2027 in case of graduates of international university) will be disqualified\n\uc11c\uc6b8\ub300\ud559\uad50 \ud559\uce59 \uc81c70\uc870\uc5d0 \uc758\uac70 \uc774\uc911\ud559\uc801\uc740 \uae08\uc9c0\ub418\ubbc0\ub85c \ubcf8\uad50 \uc785\ud559 \ud6c4 \ub458 \uc774\uc0c1\uc758 \ubcf8\uad50 \ub300\ud559(\uc6d0) \ub610\ub294 \ud0c0 \ub300\ud559\uad50\uc5d0 \ub3d9\uc2dc\uc5d0 \uc7ac\ud559 \ub610\ub294 \ud734\ud559\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \uc774\ub97c \uc704\ubc18\ud558\ub294 \uacbd\uc6b0 \ud569\uaca9 \ubc0f \uc785\ud559\uc744 \ucde8\uc18c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\nIn accordance with Article 70 of the SNU School Rules, dual registration is strictly prohibited. Applicants risk disqualification if they attend or take leave of absence from more than one SNU graduate program or any other universities while being registered at SNU. It is imperative that applicants resolve any existing registration with other university programs before enrolling at SNU.\n\ud569\uaca9\uc790\ub4f1\ub85d \ubc0f \uc81c\ucd9c\uc11c\ub958\n\ud569\uaca9\uc790 \ub4f1\ub85d\n\uae30 \uac04 : 2027. 2. 1.(\uc6d4) 10:00 ~ 2. 5.(\uae08) 16:00 \uc608\uc815\n\uc7a5 \uc18c : \uc804\uad6d \uc18c\uc7ac \ub18d\ud611, \uc2e0\ud55c\uc740\ud589 \ubc0f \uc6b0\ub9ac\uc740\ud589 \uc9c0\uc810(\uc778\ud130\ub137.\uc2a4\ub9c8\ud2b8\ud3f0\ubc45\ud0b9 \uac00\ub2a5)\n\ub4f1\ub85d\uae08\uc561 : \ub0a9\uc785\uace0\uc9c0\uc11c\ub85c \uace0\uc9c0\ud568\n\ub4f1\ub85d\uae08\uace0\uc9c0\uc11c \uad50\ubd80 : \uc11c\uc6b8\ub300\ud559\uad50 \uc785\ud559\ud648\ud398\uc774\uc9c0 \uc77c\ubc18\ub300\ud559\uc6d0 \uacf5\uc9c0\uc0ac\ud56d\uc5d0\uc11c \uc9c1\uc811 \ucd9c\ub825\n\uc9c0\uc815\ub41c \uae30\uac04 \uc911 \ub4f1\ub85d\ud558\uc9c0 \uc54a\ub294 \uacbd\uc6b0 \ud569\uaca9\uc774 \ucde8\uc18c\ub429\ub2c8\ub2e4.\n\uc81c\ucd9c\uc11c\ub958\n2027\ub144 2\uc6d4 \ub9d0\uae4c\uc9c0(\uc138\ubd80\uc77c\uc815 \ucd94\ud6c4 \uc548\ub0b4) \u261e \ud569\uaca9\uc790 \uc18c\uc18d \ub300\ud559(\uc6d0) \uad50\ubb34\ud589\uc815\uc2e4(\uc790\uc5f0\uacfc\ud559\ub300\ud559\uc740 \uc18c\uc18d \ud559\uacfc \ub610\ub294 \ud559\ubd80)\ub85c \uc81c\ucd9c\nDrag from side to side.\n\uc81c\ucd9c\uc11c\ub958\n\ube44\uace0\n\ud559\uc0ac\ud559\uc704 \uc878\uc5c5\uc99d\uba85\uc11c 1\ubd80 (\uc11d\uc0ac\u00b7\uc11d\ubc15\ud1b5\ud569\uacfc\uc815 \ud569\uaca9\uc790),\n\uc11d\uc0ac\ud559\uc704 \uc878\uc5c5\uc99d\uba85\uc11c 1\ubd80 (\ubc15\uc0ac\uacfc\uc815 \ud569\uaca9\uc790)\n\uc6d0\ubcf8\uc11c\ub958 \uc81c\ucd9c \ud544\uc218,\n\uc544\ud3ec\uc2a4\ud2f0\uc720 \uc81c\ucd9c \ub300\uc0c1(\uc678\uad6d\ub300\ud559(\uc6d0) \uc878\uc5c5)\uc740 \ud45c \ud558\ub2e8 \u203b \ucc38\uc870\n\uc678\uad6d\ub300\ud559 \uc878\uc5c5\uc790 \uc911 \ud559\uc0ac\ud559\uc704\uac00 \uc678\uad6d\ub300\ud559\uc73c\ub85c \ubc15\uc0ac\ud559\uc704\uc758 \uc601\uc5b4\uc131\uc801\uc744 \uba74\uc81c \ubc1b\uc744 \uacbd\uc6b0 \ud559\uc0ac\ud559\uc704 \uc544\ud3ec\uc2a4\ud2f0\uc720\ub97c \uc81c\ucd9c\ud574\uc57c\ud568\n\ucd9c\uc785\uad6d\uc0ac\uc2e4\uc99d\uba85\uc11c \ub610\ub294 \uc9c4\ub2e8\uc11c \ub4f1 1\ubd80\n\ud654\uc0c1\uba74\uc811\uc5d0 \uc751\uc2dc\ud558\uc5ec \ud569\uaca9\ud55c \uc790\uc5d0 \ud55c\ud568\n\ud569\uaca9\uc790 \uc911 \uc678\uad6d\ub300\ud559(\uc6d0) \uc878\uc5c5\uc790(\uc601\uc5b4\uc131\uc801 \uc81c\ucd9c\uc744 \uba74\uc81c\ubc1b\uc740 \uacbd\uc6b0 \ud3ec\ud568)\ub294 \uc544\ud3ec\uc2a4\ud2f0\uc720 \uac00\uc785\uad6d\uac00\uc778 \uacbd\uc6b0 \uc544\ud3ec\uc2a4\ud2f0\uc720 \ud655\uc778\uc11c\ub97c \ud568\uaed8 \uc81c\ucd9c\ud558\uc5ec\uc57c \ud558\uba70 \uc544\ud3ec\uc2a4\ud2f0\uc720 \ubbf8\uac00\uc785\uad6d\uc740 \uad6d\uc678\uad50\uc721\uae30\uad00\ud655\uc778\uc11c \ub610\ub294 \uc601\uc0ac\ud655\uc778\uc744 \ud568\uaed8 \uc81c\ucd9c\n\uad6d\uac00\ubcc4 \uc544\ud3ec\uc2a4\ud2f0\uc720 \uad00\ub828\uae30\uad00 \uc815\ubcf4 : [www.hcch.net](https://www.hcch.net) - Members & Parties - HCCH Members \ucc38\uace0\n\ud55c\uad6d\uc5b4\ub098 \uc601\uc5b4\ub85c \uc791\uc131\ub418\uc9c0 \uc54a\uc740 \uc11c\ub958\ub294 \uacf5\uc99d\ubc1b\uc740 \ud55c\uae00 \ub610\ub294 \uc601\ubb38 \ubc88\uc5ed\ubcf8\uc744 \ucca8\ubd80\ud574\uc57c \ud568\n\uc911\uad6d \ub300\ud559(\uc6d0) \uc878\uc5c5\uc790\ub294 \uc878\uc5c5\uc99d\uba85\uc11c \ubc0f \ud559\uc704\uc99d\uba85\uc11c\uc758 \uc601\uc0ac\ud655\uc778 \ub610\ub294 \uc544\ud3ec\uc2a4\ud2f0\uc720\ub97c \uc911\uad6d \uad50\uc721\ubd80 \ud559\uc704\uc778\uc99d\uc13c\ud130(CHSI)\uc758 Online Verification Report of Student Record\uc640 \ud568\uaed8 \uc81c\ucd9c([www.chsi.com.cn](https://www.chsi.com.cn) \ucc38\uc870)\n\ud2b9\ubcc4\ud55c \uc0ac\uc720 \uc5c6\uc774 \uc9c0\uc815\ub41c \uae30\uc77c \ub0b4\uc5d0 \uc81c\ucd9c\ud558\uc9c0 \uc54a\uc744 \uacbd\uc6b0 \ud569\uaca9\uc774 \ucde8\uc18c\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\uae30\ud0c0 \uc548\ub0b4\uc0ac\ud56d\n\uc678\uad6d\uc5b4(\uc601\uc5b4, \uc81c2\uc678\uad6d\uc5b4) \uc785\ud559(\uace0\uc0ac) \uc131\uc801\uc758 \ub17c\ubb38\uc81c\ucd9c\uc790\uaca9\uc2dc\ud5d8 \uc778\uc815\n\ubaa8\uc9d1\ub2e8\uc704\ubcc4 \uc18c\uc815 \uc810\uc218 \uc774\uc0c1\uc744 \uc81c\ucd9c(\ucde8\ub4dd)\ud55c \uc790\ub294 \ud559\uc704\uc218\uc5ec\uaddc\uc815\uc5d0 \ub530\ub77c \ub17c\ubb38\uc81c\ucd9c\uc790\uaca9\uc2dc\ud5d8\uc5d0\uc11c \ud574\ub2f9 \uacfc\ubaa9\uc744 \ud569\uaca9\uc73c\ub85c \uc778\uc815\ubc1b\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\uc11d\uc0ac\u00b7\ubc15\uc0ac\ud1b5\ud569\uacfc\uc815 \uc548\u