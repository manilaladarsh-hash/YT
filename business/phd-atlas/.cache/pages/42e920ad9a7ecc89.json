2dc\uc791\ub41c \uac00\uc7a5 \uc624\ub798\ub41c \uacf5\ud559\uc774\uc790, \uc624\ub298\ub0a0 \uc0b0\uc5c5\uacfc \uae30\uc220 \ubb38\uba85\uc744 \uc9c0\ud0f1\ud558\ub294 \ud575\uc2ec \ubb3c\ub9ac \uc6d0\ub9ac\ub97c \ud0d0\uad6c\ud558\uba70 \ubbf8\ub798 \uae30\uc220\uc758 \uae30\ubc18\uc744 \uc124\uacc4\ud558\ub294 \ud559\ubb38\uc785\ub2c8\ub2e4. \ud798\uacfc \uc6b4\ub3d9, \uc5f4\uacfc \uc720\uccb4, \uc5d0\ub108\uc9c0 \uc804\ub2ec, \uc7ac\ub8cc\uc640 \uad6c\uc870\uc5d0 \ub300\ud55c \uc774\ud574\ub97c \ubc14\ud0d5\uc73c\ub85c, \ud604\ub300 \uc0b0\uc5c5\uc758 \ud575\uc2ec \uae30\ubc18 \uae30\uc220\uc744 \uad6c\ud604\ud558\uace0 \uace0\ub3c4\ud654\ud569\ub2c8\ub2e4.\n\uc774\ub7ec\ud55c \uc6d0\ub9ac\uc801 \uae30\ubc18 \uc704\uc5d0\uc11c \uae30\uacc4\uacf5\ud559\uc740 \uc124\uacc4, \uc0dd\uc0b0, \uc2dc\uc2a4\ud15c \uad6c\ud604 \uc804\ubc18\uc5d0 \uac78\uce5c \ud3ed\ub113\uc740 \uc5f0\uad6c\ub97c \ud1b5\ud574 \uc2e4\uc81c \uc138\uacc4\uc758 \ubcf5\uc7a1\ud55c \ubb38\uc81c\ub97c \ud574\uacb0\ud558\uace0, \uc774\ub97c \ud601\uc2e0\uc801 \uae30\uc220\uacfc \uc0b0\uc5c5\uc758 \ubc1c\uc804\uc73c\ub85c \uc774\uc5b4\uac00\uace0 \uc788\uc2b5\ub2c8\ub2e4.\n\ucd5c\uadfc\uc5d0\ub294 \uc778\uacf5\uc9c0\ub2a5, \ub370\uc774\ud130 \uae30\ubc18 \ubaa8\ub378\ub9c1\uacfc \ube60\ub974\uac8c \uc735\ud569\ub418\uba74\uc11c, \uae30\uacc4\uacf5\ud559\uc740 \ubb3c\ub9ac \ubc95\uce59\uc5d0 \ub300\ud55c \uae4a\uc740 \uc774\ud574\uc640 \ub370\uc774\ud130 \uae30\ubc18 \ud559\uc2b5\uc744 \uacb0\ud569\ud558\ub294 \uc0c8\ub85c\uc6b4 \uc5f0\uad6c \ud328\ub7ec\ub2e4\uc784\uc73c\ub85c \ud655\uc7a5\ub418\uace0 \uc788\uc2b5\ub2c8\ub2e4. \ud2b9\ud788 Physical AI\ub294 \ud604\uc2e4 \uc138\uacc4\uc758 \ubb3c\ub9ac\uc801 \uc0c1\ud638\uc791\uc6a9\uc744 \uc774\ud574\ud558\uace0 \uc2a4\uc2a4\ub85c \ud310\ub2e8\ud558\uba70 \uc791\ub3d9\ud558\ub294 \uc9c0\ub2a5\ud615 \uc2dc\uc2a4\ud15c \uad6c\ud604\uc758 \ud575\uc2ec\uc73c\ub85c \ubd80\uc0c1\ud558\uba70, \uae30\uacc4\uacf5\ud559 \uc5f0\uad6c\uc758 \uc0c8\ub85c\uc6b4 \uac00\ub2a5\uc131\uc744 \uc5f4\uace0 \uc788\uc2b5\ub2c8\ub2e4. \uc774\uc640 \ud568\uaed8 \uc5f0\uad6c\uc758 \ubc94\uc704\ub294 \uc804\ud1b5\uc801\uc778 \uae30\uacc4 \uc2dc\uc2a4\ud15c\uc744 \ub118\uc5b4 \ucca8\ub2e8 \uc81c\uc870, \ubc14\uc774\uc624\u00b7\uc758\ub8cc, \ubc18\ub3c4\uccb4, \ub9c8\uc774\ud06c\ub85c\u00b7\ub098\ub178 \uacf5\ud559 \ub4f1 \ub2e4\uc591\ud55c \uc735\ud569 \ubd84\uc57c\ub85c \ube60\ub974\uac8c \ud655\uc7a5\ub418\uace0 \uc788\uc2b5\ub2c8\ub2e4.\n\uc774\ucc98\ub7fc \uae30\uacc4\uacf5\ud559\uc740 \uc9c0\uc18d\uac00\ub2a5 \uc5d0\ub108\uc9c0, \uc9c0\ub2a5\ud615 \uc2dc\uc2a4\ud15c, \ucca8\ub2e8 \uc0dd\uc0b0 \uae30\uc220\uacfc \uac19\uc740 \ubbf8\ub798 \uae30\uc220\uc758 \ud575\uc2ec \ub09c\uc81c\ub97c \ud574\uacb0\ud558\uba70 \uc0c8\ub85c\uc6b4 \uc0b0\uc5c5\uacfc \uc735\ud569 \uc5f0\uad6c\ub97c \uc120\ub3c4\ud558\ub294 \uc911\uc2ec \ud559\ubb38\uc73c\ub85c \ubc1c\uc804\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4.\n\uac1c\uc778\uc815\ubcf4\ucc98\ub9ac\ubc29\uce68\n\ubc95\uc801\uace0\uc9c0\n(03722) \uc11c\uc6b8\ud2b9\ubcc4\uc2dc \uc11c\ub300\ubb38\uad6c \uc5f0\uc138\ub85c 50 \uc5f0\uc138\ub300\ud559\uad50 \uacf5\uacfc\ub300\ud559\ncopyrights (C) 2020 YONSEI UNIVERSITY College of Engineering. All rights reserved\n\uad50\ub0b4\uc8fc\uc694\uc0ac\uc774\ud2b8\n\uad50\ubaa9\uc2e4\n\uad6d\uc81c\ucc98\n\ub9ac\ub354\uc2ed\uc13c\ud130\n\uc5f0\uad6c\ucc98/\uc0b0\ud559\ud611\ub825\ub2e8\n\uc5f0\uc138\ucd98\ucd94\n\uc6f9\uba54\uc77c\n\uc77c\ubc18\ub300\ud559\uc6d0\n\ud559\uc0ac\ud3ec\ud0c8\uc2dc\uc2a4\ud15c\n\uc815\ubcf4\ud1b5\uc2e0\uc11c\ube44\uc2a4\n\ud559\uc220\uc815\ubcf4\uc11c\ube44\uc2a4\n\uc911\uc559\ubc15\ubb3c\uad00\n\ucde8\uc5c5\uc548\ub0b4\n\ud55c\uad6d\uc5b4\ud559\ub2f9\n\ud559\uc220\uc815\ubcf4\uc11c\ube44\uc2a4(\uc6d0\uc8fc)\nTOP", "links": [["\ubcf8\ubb38 \ubc14\ub85c\uac00\uae30", "https://engineering.yonsei.ac.kr/engineering/about/major_6_1.do#jwxe_main_content"], ["\uc8fc\uba54\ub274 \ubc14\ub85c\uac00\uae30", "https://engineering.yonsei.ac.kr/engineer