ac74\ub300\ud559\uc6d0\nPrevious slide\nNext slide\n\uc11c\uc6b8\ub300\ud559\uad50 \ubcf4\uac74\ub300\ud559\uc6d0\nGraduate School of Public Health\n\uc11c\uc6b8\ub300\ud559\uad50 \ubcf4\uac74\ub300\ud559\uc6d0\uc740 \uc6b0\ub9ac\ub098\ub77c \ucd5c\ucd08\uc758 \ubcf4\uac74\ub300\ud559\uc6d0\uc73c\ub85c\uc11c \uc0ac\ub78c\uacfc \ud658\uacbd\uc744 \ubcf4\ud638\ud558\uae30 \uc704\ud55c \uc5f0\uad6c\ub97c \uc120\ub3c4\ud558\uace0 \uc0ac\ud68c\uc640 \ud658\uacbd\uc758 \uc694\uad6c\uc5d0 \ubd80\uc751\ud558\ub294 \uc2e4\ucc9c\uc801 \uc5ed\ud560\uc744 \ub2f4\ub2f9\ud558\uba70 \uc804\ubb38\uc801, \uad6d\uc81c\uc801 \uc5ed\ub7c9\uc744 \uac16\ucd98 \uae00\ub85c\ubc8c \ub9ac\ub354\ub85c\uc11c\uc758 \ubcf4\uac74\ud559 \uc804\ubb38 \uc778\ub825\uc744 \uc591\uc131\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4.\n\uacf5\uc2dd \uc720\ud29c\ube0c\ucc44\ub110 \ubc14\ub85c\uac00\uae30\nPlay Video\n\ud31d\uc5c5\uc874\nPrevious slide\nNext slide\n\ud559\uc0ac\uacf5\uc9c0\n.\n\ud55c\uad6d\uc7a5\ud559\uc7ac\ub2e8 \ud559\uc790\uae08 \uc911\ubcf5\uc9c0\uc6d0 \ubc29\uc9c0\n2026-11-12\n2027-2028 \uc774\uc2a4\ub77c\uc5d8 \uc815\ubd80\ucd08\uccad \uc7a5\ud559\uc0dd \uc120\ubc1c \uc548\ub0b4\n2026-11-11\n2026\ud559\ub144\ub3c4 2\ud559\uae30 \uae00\ub85c\ubc8c \ucd08\uc6b0\uc218 \uc7a5\ud559\uae08(SNU Global Scholarship, GS2) \ucd94\uac00 \uc120\ubc1c \uc548\ub0b4\n2026-11-09\n\uc815\ubd80\ucd08\uccad\uc678\uad6d\uc778\uc7a5\ud559\uc0dd \u300cAsia K-Banker School\u300d \ucc38\uac00 \uc2e0\uccad \uc548\ub0b4\n2026-11-09\n2026\ud559\ub144\ub3c4 2\ud559\uae30 \ubc15\uc0ac\ud559\uc704 \ub17c\ubb38\uc694\uc9c0 \ubc1c\ud45c\ud68c \uc548\ub0b4\n2026-11-02\n2026\ud559\ub144\ub3c4 2\ud559\uae30 \u300c\uac15\uc758 \uc911\uac04 \uc218\uac15\uc18c\uac10 \uc870\uc0ac\u300d \uc2e4\uc2dc \uc548\ub0b4\n2026-11-02\n2026\ud559\ub144\ub3c4 2\ud559\uae30 [\u6d77\u5143 \ubbf8\ub798\ubcf4\uac74\ud559\uc790 \uc591\uc131\uae30\uae08] \uc6b0\uc218\ub17c\ubb38 \uc7a5\ud559\uae08 \uc7a5\ud559\uc0dd \uc120\ubc1c \uc548\ub0b4\n2026-11-02\n[\uadf8\ub9b0\ubc14\uc774\uc624 \ud601\uc2e0\uc735\ud569\ub300\ud559] 2026\ud559\ub144\ub3c4 \ub3d9\uacc4 \uacc4\uc808\ud559\uae30 \ucda9\ub0a8\ub300\ud559\uad50 \uad50\ub958 \uc218\ud559 \uc548\ub0b4\n2026-10-26\n2027\ud559\ub144\ub3c4 2\ud559\uae30 \ud574\uc678\ud30c\uacac \uad50\ud658\ud559\uc0dd \ubaa8\uc9d1 \uc124\uba85\ud68c \uc548\ub0b4\n2026-10-23\n2026\ub144 2\ud559\uae30 SNU Global EDGE Fellowship \ud504\ub85c\uadf8\ub7a8 \uc7a5\ud559\uc0dd \ubaa8\uc9d1 \uc548\ub0b4(\ub300\uc0c1 \ud655\ub300)\n2026-10-22\nGSPH \ub274\uc2a4\n.\nCASA \uc81c8\ucc28 \uae30\uc220\ud68c\uc758 \ud544\ub9ac\ud540 \ub9c8\ub2d0\ub77c\uc11c \uac1c\ucd5c\n2026\ub144\ub3c4 KOFIH \uc774\uc885\uc6b1 \ud3a0\ub85c\uc6b0\uc2ed \ud504\ub85c\uadf8\ub7a8 \ubcf4\uac74\uc7ac\uc815\uacbd\uc81c\uacfc\uc815 \ud604\uc9c0 \uc0ac\ud6c4\uad00\ub9ac \u2018UHC and Strategic Purchasing Forum 2026\u2019 \uac1c\ucd5c\n2026\ub144\ub3c4 KOFIH \uc774\uc885\uc6b1 \ud3a0\ub85c\uc6b0\uc2ed \ud504\ub85c\uadf8\ub7a8 \ubcf4\uac74\uc7ac\uc815\uacbd\uc81c\uacfc\uc815 \uc131\ub8cc\n\uc81c80\ud68c \ud6c4\uae30 \ubcf4\uac74\ub300\ud559\uc6d0 \ud559\uc704\uc218\uc5ec\uc2dd\n2026\ud559\ub144\ub3c4 2\ud559\uae30 \uc2e0\uc785\uc0dd \uc624\ub9ac\uc5d4\ud14c\uc774\uc158\n\uc11c\uc6b8\ub300\ud559\uad50 \ubcf4\uac74\ud559 \ubc15\uc0ac\ud68c, 2026\ub144 \uc815\uae30\ud559\uc220\ub300\ud68c \uac1c\ucd5c\n\uc138\ubbf8\ub098\uc815\ubcf4\n\ub354\ubcf4\uae30\n11/16(\uc6d4), \ubcf4\uac74\ud1b5\uacc4\ud559 \uc138\ubbf8\ub098\n11/20(\uae08), \uc81c1\ud68c \uad6d\ub9bd\uc18c\ubc29\ubcd1\uc6d0 \uc18c\ubc29\uc758\ud559 \uad6d\uc81c \uc2ec\ud3ec\uc9c0\uc5c4\n11/18(\uc218), [\uc218\uc694\uc138\ubbf8\ub098] \uac19\uc740 \uc751\uae09\uc2e4\uc740 \uc5c6\uc5c8\ub2e4\uff0d\uad6d\ub0b4\uc678 \uc758\ub8cc\ucde8\uc57d\uc9c0 \uc751\uae09\uc758\ub8cc\uc758 \ud604\uc2e4\uacfc \uacfc\uc81c\nGSPH BOARD\n\uc785\ud559\uacf5\uc9c0\n\uc77c\ubc18\uacf5\uc9c0\n\uc138\ubbf8\ub098\uc815\ubcf4\n\uc790\ub8cc\uc2e4\n\ub3d9\ucc3d\ud68c\uc18c\uc2dd\n\uc785\ud559\uacf5\uc9c0\n2027\ud559\ub144\ub3c4 \ub300\ud559\uc6d0 \uc804\uae30\ubaa8\uc9d1 \uc11d\uc0ac 1\ub2e8\uacc4 \ud569\uaca9\uc790 \ubc1c\ud45c \ubc0f \uc11d\u00b7\ubc15\uc0ac \uba74\uc811\uc548\ub0b4\n2026-10-19\n2027\ud559\ub144\ub3c4 \ub300\ud559\uc6d0 \uc2e0\uc785\uc0dd \uc804\uae30\ubaa8\uc9d1 \uc785\uc2dc\uc694\uac15\n2026-08-27\n2026\ud559\ub144\ub3c4 \ub300\ud559\uc6d0 \uc2e0\uc785\uc0dd \ud6c4\uae30\ubaa8\uc9d1 \ucd5c\uc885\ud569\uaca9\uc790 \ubc1c\ud45c \uc548\ub0b4\n2026-06-11\n2026\ud559\ub144\ub3c4 \ub300\ud559\uc6d0 \ud6c4\uae30\ubaa8\uc9d1 \uc11d\uc0ac 1\ub2e8\uacc4 \ud569\uaca9\uc790 \ubc1c\ud45c \ubc0f \uc11d\u00b7\ubc15\uc0ac \uba74\uc811\uc548\ub0b4\n2026-04-30\n2026\ud559\ub144\ub3c4 \ub300\ud559\uc6d0 \uc2e0\uc785\uc0dd \ud6c4\uae30\ubaa8\uc9d1 \uc785\uc2dc\uc694\uac15\n2026-03-16\n2026\ud559\ub144\ub3c4 \ub300\ud559\uc6d0 \uc2e0\uc785\uc0dd \uc804\uae30\ubaa8\uc9d1 \ucd5c\uc885\ud569\uaca9\uc790 \ubc1c\ud45c \uc548\ub0b4\n2025-11-20\n2026\ud559\ub144\ub3c4 \ub300\ud559\uc6d0 \uc804\uae30\ubaa8\uc9d1 \uc11d\uc0ac 1\ub2e8\uacc4 \ud569\uaca9\uc790 \ubc1c\ud45c \ubc0f \uc11d\u00b7\ubc15\uc0ac \uba74\uc811\uc548\ub0b4\n2025-10-16\n2026\ud559\ub144\ub3c4 \ub300\ud559\uc6d0 \uc2e0\uc785\uc0dd \uc804\uae30\ubaa8\uc9d1 \uc785\uc2dc\uc694\uac15\n2025-08-28\n\uc77c\ubc18\uacf5\uc9c0\n[\ube45\ub370\uc774\ud130 \ud601\uc2e0\uc735\ud569\ub300\ud559\uc0ac\uc5c5\ub2e8] AI \uc2dc\ub300 \ud68c\ubcf5\ud0c4\ub825\uc131 \ud5a5\uc0c1 \ube44\uad50\uacfc \ud504\ub85c\uadf8\ub7a8 \uc548\ub0b4\n2026-11-12\n\ubcf4\uac74\ub300\ud559\uc6d0 \uacf5\uc6a9\uacf5\uac04(3~6\uce35 \ubcf5\ub3c4) \ub3c4\uc7a5\uacf5\uc0ac \uc2dc\ud589 \uc548\ub0b4 \ubc0f \ud611\uc870 \uc694\uccad\n2026-11-11\n\uc81c2\ucc28 \uac10\uc5fc\ubcd1 \uc704\uae30 \uc0ac\ud68c\ub300\uc751 \uc138\ubbf8\ub098 \uac1c\ucd5c \uc548\ub0b4 \ubc0f \ucc38\uc11d \uc694\uccad\n2026-11-11\n\ud559\ub0b4 \ubb34\uc120\ub79c(eduroam) \uc11c\ube44\uc2a4 \uc548\uc815\ud654 \uc791\uc5c5\uc5d0 \ub530\ub978 \uc774\uc6a9 \uc548\ub0b4\n2026-11-11\n2026\ub144 11\uc6d4 \uad00\uc545\ucea0\ud37c\uc2a4 \uc18c\ubc29\ucc28 \uc9c4\uc785 \ud569\ub3d9\ud6c8\ub828 \uc2e4\uc2dc \uc548\ub0b4\n2026-11-11\n2026\ub144 \uad6d\ub9bd\uad6d\uc81c\uad50\uc721\uc6d0 \uc778\uc9c0\ub3c4 \uc870\uc0ac \uc548\ub0b4\n2026-11-09\n2026\ub144 \ubc95\uc815\uc758\ubb34\uad50\uc721(\uc0ac\ud68c\uc801 \uc7a5\uc560\uc778\uc2dd\uac1c\uc120\uad50\uc721) \uc774\uc218 \ud611\uc870 \uc694\uccad\n2026-11-09\n\u300c2026 \uc81c\uc57d\ubc14\uc774\uc624\ud22c\uc790\ub300\uc804\u300d \uac1c\ucd5c\uc548\ub0b4 \ubc0f \uad00\ub78c \ud611\uc870 \uc694\uccad\n2026-11-09\n\uc138\ubbf8\ub098\uc815\ubcf4\n11/16(\uc6d4), \ubcf4\uac74\ud1b5\uacc4\ud559 \uc138\ubbf8\ub098\n2026-11-09\n11/20(\uae08), \uc81c1\ud68c \uad6d\ub9bd\uc18c\ubc29\ubcd1\uc6d0 \uc18c\ubc29\uc758\ud559 \uad6d\uc81c \uc2ec\ud3ec\uc9c0\uc5c4\n2026-11-05\n11/18(\uc218), [\uc218\uc694\uc138\ubbf8\ub098] \uac19\uc740 \uc751\uae09\uc2e4\uc740 \uc5c6\uc5c8\ub2e4\uff0d\uad6d\ub0b4\uc678 \uc758\ub8cc\ucde8\uc57d\uc9c0 \uc751\uae09\uc758\ub8cc\uc758 \ud604\uc2e4\uacfc \uacfc\uc81c\n2026-11-04\n11/12(\ubaa9), \uad6d\uc81c\ubcf4\uac74\uc13c\ud130 \uc804\ubb38\uac00 \ucd08\uccad \uac15\uc5f0\uc138\ubbf8\ub098 \uc2dc\ub9ac\uc988: \uad6d\uacbd\uc5c6\ub294\uc758\uc0ac\ud68c(MSF)\uc804\ubb38\uac00 \ucd08\uccad \uc138\ubbf8\ub098\n2026-11-04\n\ucd08\ub85d\uc811\uc218:~11.13 (\uae08), EPICOH 2027 Early Career Edition \ud559\ud68c \uc548\ub0b4\n2026-10-30\n11/20(\uae08)&11/27(\uae08), [2026 \uc11c\uc6b8\ub300 \ubcf4\uac74\ub300\ud559\uc6d0 AI Days] AI \uc2dc\ub300\uc758 \ubcf4\uac74\ud559 \u201c\ubb34\uc5c7\uc744 \ubb3b\uace0, \uc5b4\ub5bb\uac8c \uac00\ub974\uce60 \uac83\uc778\uac00\u201d \uc0ac\uc804\ub4f1\ub85d \uc548\ub0b4\n2026-10-28\n11/20(\uae08), \ud55c\uad6d\ubcf4\uac74\ub300\ud559\uc6d0\ud611\uc758\ud68c \ucd94\uacc4\ud559\uc220\ub300\ud68c\n2026-10-27\n11/3(\ud654), \uc11c\uc6b8\ub300 \ubcf4\uac74\ub300\ud559\uc6d0-\ub9c8\ud788\ub3cc\ub300 \ubcf4\uac74\ub300\ud559 \ud559\uc220\uad50\ub958\ud68